---
---

<header class="navbar">
  <div class="container navbar__content">

    <a href="/" class="navbar__logo">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle;"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg> BiblioTech <span class="logo-badge">Store</span>
    </a>

    <nav class="navbar__links" aria-label="Navegación principal">
      <a href="/" class="nav-item">Inicio</a>
      <a href="/catalogo" class="nav-item">Catálogo</a>
      <a href="/ordenes" class="nav-item">Mis Órdenes</a>
    </nav>

    <div class="navbar__actions">

      <!-- Zona de autenticación dinámica (Rafa - Paso 2) -->
      <div class="navbar__auth" id="navbar-auth-zone">
        <slot name="auth">
          <a href="/login" class="btn btn-outline btn-sm auth-login-btn">
            Iniciar Sesión
          </a>

          <a href="/registro" class="btn btn-primary btn-sm auth-reg-btn">
            Registrarse
          </a>
        </slot>
      </div>

      <!-- Carrito de compras (Emmy - Paso 4) -->
      <a href="/carrito" class="navbar__cart" aria-label="Carrito" id="navbar-cart-btn">
        <span class="cart-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle;"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg></span>
        <span class="cart-badge" id="cart-badge">0</span>
      </a>

    </div>

  </div>
</header>





<style>
  .navbar {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
  }

  .navbar__content {
    min-height: 4rem;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-lg);
  }

  .navbar__logo {
    color: var(--color-primary);
    font-size: 1.25rem;
    font-weight: 700;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .logo-badge {
    font-size: 0.75rem;
    background: #dbeafe;
    color: var(--color-primary);
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
    text-transform: uppercase;
  }

  .navbar__links {
    display: flex;
    align-items: center;
    gap: var(--spacing-lg);
  }

  .navbar__links a {
    color: var(--color-text-muted);
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .navbar__links a:hover {
    color: var(--color-primary);
  }

  .navbar__actions {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
  }

  .navbar__auth {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .navbar__cart {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.6rem;
    border-radius: var(--radius-md);
    background: var(--color-background);
    border: 1px solid var(--color-border);
    transition: all 0.2s ease;
  }

  .navbar__cart:hover {
    border-color: var(--color-primary);
    transform: translateY(-1px);
  }

  .cart-icon {
    font-size: 1.2rem;
  }

  .cart-badge {
    position: absolute;
    top: -6px;
    right: -6px;
    background-color: var(--color-primary);
    color: white;
    font-size: 0.7rem;
    font-weight: 700;
    min-width: 1.15rem;
    height: 1.15rem;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 0.2rem;
    box-shadow: 0 2px 4px rgba(37, 99, 235, 0.4);
  }

  .navbar-user-area {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .navbar-user-name {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-primary);
    white-space: nowrap;
  }

  :global(.navbar-user-area) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  :global(.navbar-user-name) {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-primary);
    white-space: nowrap;
  }

  :global(.admin-menu) {
    position: relative;
  }

  :global(.admin-menu__button) {
    width: 34px;
    height: 34px;

    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;

    gap: 4px;
    padding: 0;

    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);

    background: var(--color-surface);
    cursor: pointer;

    transition: all 0.2s ease;
  }

  :global(.admin-menu__button:hover) {
    background: var(--color-background);
    border-color: var(--color-primary);
  }

  :global(.admin-menu__button span) {
    display: block;

    width: 16px;
    height: 2px;

    background: var(--color-text-muted);
    border-radius: 2px;
  }

  :global(.admin-menu__button:hover span) {
    background: var(--color-primary);
  }

  :global(.admin-menu__dropdown) {
    position: absolute;

    top: calc(100% + 0.5rem);
    right: 0;

    min-width: 160px;

    padding: 0.4rem;

    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);

    box-shadow: var(--shadow-md);

    display: none;

    z-index: 1000;
  }

  :global(.admin-menu__dropdown--open) {
    display: block;
  }

  :global(.admin-menu__dropdown a) {
    display: block;

    padding: 0.65rem 0.75rem;

    border-radius: var(--radius-sm);

    color: var(--color-text-muted);
    text-decoration: none;

    font-size: 0.88rem;
    font-weight: 500;

    white-space: nowrap;
  }

  :global(.admin-menu__dropdown a:hover) {
    background: var(--color-background);
    color: var(--color-primary);
  }

  .user-menu {
    position: relative;
  }

  .user-menu__trigger {
    border: none;
    background: transparent;
    color: var(--color-primary);
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    padding: 0.25rem 0.4rem;
    border-radius: var(--radius-sm);
    transition: background 0.2s ease;
  }

  .user-menu__trigger:hover {
    background: var(--color-background);
  }

  .user-menu__dropdown {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    min-width: 160px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    padding: 0.4rem;
    display: none;
    z-index: 1000;
  }

  .user-menu__dropdown--open {
    display: block;
  }

  .user-menu__admin {
    display: block;
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .user-menu__admin:hover {
    background: var(--color-background);
    color: var(--color-primary);
  }

  @media (max-width: 768px) {
    .navbar__content {
      flex-wrap: wrap;
      padding-block: var(--spacing-md);
    }

    .navbar__links {
      order: 3;
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script is:inline>
  function updateNavBarState() {
    const authZone = document.getElementById('navbar-auth-zone');

    if (authZone) {
      const token = localStorage.getItem('auth_token');
      const userRaw = localStorage.getItem('auth_user');

      if (token && userRaw) {
        try {
          const user = JSON.parse(userRaw);

          const primerNombre =
            user.nombre
              ? user.nombre.split(' ')[0]
              : 'Usuario';

          authZone.innerHTML = `
            <div class="navbar-user-area">

              <span class="navbar-user-name">
                Hola, ${primerNombre}
              </span>

              ${
                user.rol === 'ADMIN'
                  ? `
                    <div class="admin-menu">
                      <button
                        type="button"
                        class="admin-menu__button"
                        id="admin-menu-button"
                        aria-label="Abrir menú de administrador"
                        aria-expanded="false"
                      >
                        <span></span>
                        <span></span>
                        <span></span>
                      </button>

                      <div
                        class="admin-menu__dropdown"
                        id="admin-menu-dropdown"
                      >
                        <a href="/admin">
                          Panel Admin
                        </a>
                      </div>
                    </div>
                  `
                  : ''
              }

              <button
                id="nav-logout-btn"
                class="btn btn-outline btn-sm"
                style="
                  padding:0.25rem 0.55rem;
                  font-size:0.8rem;
                "
              >
                Salir
              </button>

            </div>
          `;

          /*
           * MENÚ ADMIN
           */
          if (user.rol === 'ADMIN') {
            const adminButton =
              document.getElementById(
                'admin-menu-button'
              );

            const adminDropdown =
              document.getElementById(
                'admin-menu-dropdown'
              );

            if (adminButton && adminDropdown) {

              adminButton.addEventListener(
                'click',
                (event) => {
                  event.stopPropagation();

                  adminDropdown.classList.toggle(
                    'admin-menu__dropdown--open'
                  );

                  const abierto =
                    adminDropdown.classList.contains(
                      'admin-menu__dropdown--open'
                    );

                  adminButton.setAttribute(
                    'aria-expanded',
                    abierto.toString()
                  );
                }
              );

              document.addEventListener(
                'click',
                () => {
                  adminDropdown.classList.remove(
                    'admin-menu__dropdown--open'
                  );

                  adminButton.setAttribute(
                    'aria-expanded',
                    'false'
                  );
                }
              );
            }
          }

          /*
           * CERRAR SESIÓN
           */
          const logoutBtn =
            document.getElementById(
              'nav-logout-btn'
            );

          if (logoutBtn) {
            logoutBtn.addEventListener(
              'click',
              () => {

                localStorage.removeItem(
                  'auth_token'
                );

                localStorage.removeItem(
                  'auth_user'
                );

                window.dispatchEvent(
                  new CustomEvent(
                    'auth-changed'
                  )
                );

                if (window.showToast) {
                  window.showToast(
                    'Sesión cerrada correctamente',
                    'info'
                  );
                }

                setTimeout(() => {
                  window.location.href = '/';
                }, 400);
              }
            );
          }

        } catch (error) {
          console.error(
            'Error leyendo usuario:',
            error
          );
        }

      } else {

        authZone.innerHTML = `
          <a
            href="/login"
            class="btn btn-outline btn-sm"
          >
            Iniciar Sesión
          </a>

          <a
            href="/registro"
            class="btn btn-primary btn-sm"
          >
            Registrarse
          </a>
        `;
      }
    }

    /*
     * CARRITO
     */
    const cartBadge =
      document.getElementById('cart-badge');

    if (cartBadge) {
      try {
        const cart =
          JSON.parse(
            localStorage.getItem(
              'ecommerce_cart'
            ) || '[]'
          );

        const count =
          cart.reduce(
            (acc, item) =>
              acc + (item.cantidad || 1),
            0
          );

        cartBadge.textContent =
          count.toString();

        cartBadge.style.display =
          count > 0
            ? 'flex'
            : 'none';

      } catch (error) {
        cartBadge.textContent = '0';
        cartBadge.style.display = 'none';
      }
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener(
      'DOMContentLoaded',
      updateNavBarState
    );
  } else {
    updateNavBarState();
  }

  window.addEventListener(
    'cart-updated',
    updateNavBarState
  );

  window.addEventListener(
    'auth-changed',
    updateNavBarState
  );

  window.addEventListener(
    'storage',
    updateNavBarState
  );
</script>