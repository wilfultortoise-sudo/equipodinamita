---
---

<header class="navbar">
  <div class="container navbar__content">

    <a href="/" class="navbar__logo">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle;"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg> BiblioTech <span class="logo-badge">Store</span>
    </a>

    <nav class="navbar__links" aria-label="Navegación principal">
      <a href="/" class="nav-item">Inicio</a>
      <a href="/catalogo" class="nav-item">Catálogo</a>
      <a href="/ordenes" class="nav-item">Mis Órdenes</a>
      <div id="navbar-admin-links" style="display:inline-flex; align-items:center; gap:var(--spacing-lg);"></div>
    </nav>

    <div class="navbar__actions">

      <!-- Zona de autenticación dinámica (Rafa - Paso 2) -->
      <div class="navbar__auth" id="navbar-auth-zone">
        <slot name="auth">
          <a href="/login" class="btn btn-outline btn-sm auth-login-btn">Iniciar Sesión</a>
          <a href="/registro" class="btn btn-primary btn-sm auth-reg-btn">Registrarse</a>
        </slot>
      </div>

      <!-- Carrito de compras (Emmy - Paso 4) -->
      <a href="/carrito" class="navbar__cart" aria-label="Carrito" id="navbar-cart-btn">
        <span class="cart-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle;"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg></span>
        <span class="cart-badge" id="cart-badge">0</span>
      </a>

    </div>

  </div>
</header>





<style>
  .navbar {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
  }

  .navbar__content {
    min-height: 4rem;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-lg);
  }

  .navbar__logo {
    color: var(--color-primary);
    font-size: 1.25rem;
    font-weight: 700;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .logo-badge {
    font-size: 0.75rem;
    background: #dbeafe;
    color: var(--color-primary);
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
    text-transform: uppercase;
  }

  .navbar__links {
    display: flex;
    align-items: center;
    gap: var(--spacing-lg);
  }

  .navbar__links a {
    color: var(--color-text-muted);
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .navbar__links a:hover {
    color: var(--color-primary);
  }

  .navbar__actions {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
  }

  .navbar__auth {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .navbar__cart {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.6rem;
    border-radius: var(--radius-md);
    background: var(--color-background);
    border: 1px solid var(--color-border);
    transition: all 0.2s ease;
  }

  .navbar__cart:hover {
    border-color: var(--color-primary);
    transform: translateY(-1px);
  }

  .cart-icon {
    font-size: 1.2rem;
  }

  .cart-badge {
    position: absolute;
    top: -6px;
    right: -6px;
    background-color: var(--color-primary);
    color: white;
    font-size: 0.7rem;
    font-weight: 700;
    min-width: 1.15rem;
    height: 1.15rem;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 0.2rem;
    box-shadow: 0 2px 4px rgba(37, 99, 235, 0.4);
  }

  @media (max-width: 768px) {
    .navbar__content {
      flex-wrap: wrap;
      padding-block: var(--spacing-md);
    }

    .navbar__links {
      order: 3;
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script is:inline>
  function updateNavBarState() {
    // 1. Actualizar estado de autenticación (Rafa - Paso 2 + Admin Dashboard)
    const authZone = document.getElementById('navbar-auth-zone');
    const adminNavLinks = document.getElementById('navbar-admin-links');
    
    if (authZone) {
      const token = localStorage.getItem('auth_token');
      const userRaw = localStorage.getItem('auth_user');
      if (token && userRaw) {
        try {
          const user = JSON.parse(userRaw);
          const primerNombre = user.nombre ? user.nombre.split(' ')[0] : 'Usuario';
          const isAdmin = user.rol === 'ADMIN';

          if (adminNavLinks) {
            adminNavLinks.innerHTML = isAdmin ? `
              <a href="/admin" class="nav-item admin-nav-link" style="color:#d97706; font-weight:700; display:inline-flex; align-items:center; gap:0.25rem;">
                🛡️ Panel Admin
              </a>
              <a href="/admin/productos" class="nav-item" style="color:var(--color-primary); font-weight:600;">
                📦 Inventario
              </a>
            ` : '';
          }

          authZone.innerHTML = `
            <div style="display:flex; align-items:center; gap:0.5rem;">
              <div style="text-align:right; line-height:1.2;">
                <span style="font-size:0.88rem; font-weight:700; color:var(--color-primary);">${primerNombre}</span>
                ${isAdmin ? '<span class="badge" style="background:#fef3c7; color:#92400e; font-size:0.65rem; padding:0.1rem 0.35rem; display:block;">ADMIN</span>' : ''}
              </div>
              <button id="nav-logout-btn" class="btn btn-outline btn-sm" style="padding:0.25rem 0.55rem; font-size:0.8rem;">Salir</button>
            </div>
          `;
          const logoutBtn = document.getElementById('nav-logout-btn');
          if (logoutBtn) {
            logoutBtn.addEventListener('click', () => {
              localStorage.removeItem('auth_token');
              localStorage.removeItem('auth_user');
              window.dispatchEvent(new CustomEvent('auth-changed'));
              if (window.showToast) window.showToast('Sesión cerrada correctamente', 'info');
              setTimeout(() => {
                window.location.href = '/';
              }, 400);
            });
          }
        } catch (e) {
          console.error(e);
        }
      } else {
        if (adminNavLinks) adminNavLinks.innerHTML = '';
        authZone.innerHTML = `
          <a href="/login" class="btn btn-outline btn-sm">Iniciar Sesión</a>
          <a href="/registro" class="btn btn-primary btn-sm">Registrarse</a>
        `;
      }
    }

    // 2. Actualizar contador del carrito (Emmy - Paso 4)
    const cartBadge = document.getElementById('cart-badge');
    if (cartBadge) {
      try {
        const cart = JSON.parse(localStorage.getItem('ecommerce_cart') || '[]');
        const count = cart.reduce((acc, item) => acc + (item.cantidad || 1), 0);
        cartBadge.textContent = count.toString();
        cartBadge.style.display = count > 0 ? 'flex' : 'none';
      } catch (e) {
        cartBadge.textContent = '0';
        cartBadge.style.display = 'none';
      }
    }
  }

  // Ejecutar al cargar la página
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', updateNavBarState);
  } else {
    updateNavBarState();
  }

  // Escuchar eventos globales de cambio de carrito o autenticación
  window.addEventListener('cart-updated', updateNavBarState);
  window.addEventListener('auth-changed', updateNavBarState);
  window.addEventListener('storage', updateNavBarState);
</script>