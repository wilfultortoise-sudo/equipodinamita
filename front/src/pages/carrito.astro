---
import BaseLayout from '../layouts/BaseLayout.astro';
const pageTitle = "Mi Carrito de Compras — BiblioTech Store";
---

<BaseLayout pageTitle={pageTitle}>
  <div class="cart-page">
    <div class="container">
      
      <div class="cart-hero">
        <h1>Mi Carrito de Compras</h1>
        <p>Revisa tus libros seleccionados antes de proceder al pago seguro.</p>
      </div>

      <div id="cart-empty-view" class="card empty-cart-card" style="display: none;">
        <div class="empty-icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
        </div>
        <h2>Tu carrito está vacío</h2>
        <p>Aún no has agregado ningún libro a tu carrito. ¡Explora nuestro catálogo y descubre tu próxima lectura!</p>
        <a href="/catalogo" class="btn btn-primary">Explorar Catálogo de Libros</a>
      </div>

      <div id="cart-content-view" class="cart-layout" style="display: none;">
        
        <!-- Lista de Artículos -->
        <div class="cart-items-col">
          <div class="card cart-items-card">
            <div class="cart-items-header">
              <span id="cart-items-title" class="items-count-title">Artículos en el carrito</span>
              <button id="clear-all-cart-btn" class="btn-text-danger">Vaciar carrito</button>
            </div>

            <div id="cart-items-container" class="cart-items-list">
              <!-- Renderizado dinámicamente con JavaScript -->
            </div>
          </div>

          <!-- Banner de Envío Gratis -->
          <div id="shipping-progress-box" class="card shipping-banner">
            <div class="shipping-info-row">
              <span class="shipping-truck">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle;"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
              </span>
              <span id="shipping-msg-text" class="shipping-msg">Agrega libros para obtener envío gratis</span>
            </div>
            <div class="progress-track">
              <div id="shipping-progress-bar" class="progress-fill" style="width: 0%;"></div>
            </div>
          </div>
        </div>

        <!-- Resumen Financiero y Checkout -->
        <aside class="cart-summary-col">
          <div class="card summary-card">
            <h3>Resumen del Pedido</h3>

            <!-- Desglose -->
            <div class="summary-breakdown">
              <div class="breakdown-row">
                <span class="row-label">Subtotal</span>
                <span id="summary-subtotal" class="row-val">$0.00 MXN</span>
              </div>

              <div id="discount-row" class="breakdown-row discount-row" style="display: none;">
                <span class="row-label">Descuento aplicado (<span id="discount-name"></span>)</span>
                <span id="summary-discount" class="row-val-discount">-$0.00 MXN</span>
              </div>

              <div class="breakdown-row">
                <span class="row-label">Envío</span>
                <span id="summary-shipping" class="row-val">$99.00 MXN</span>
              </div>

              <div class="breakdown-sep"></div>

              <div class="breakdown-row total-row">
                <span class="total-label">Total a Pagar</span>
                <span id="summary-total" class="total-val">$0.00 MXN</span>
              </div>
            </div>

            <!-- Cupón de Descuento -->
            <div class="coupon-section">
              <label for="coupon-input" class="coupon-label">Cupón de Descuento</label>
              <div class="coupon-input-box">
                <input 
                  type="text" 
                  id="coupon-input" 
                  placeholder="Ej. BIBLIO10 o CETI2026" 
                  class="form-input coupon-field"
                  autocomplete="off"
                />
                <button type="button" id="apply-coupon-btn" class="btn btn-secondary btn-sm">Aplicar</button>
              </div>
              <div id="coupon-alert" class="coupon-alert" style="display: none;"></div>
            </div>

            <!-- Botón de Proceder al Checkout -->
            <button type="button" id="proceed-checkout-btn" class="btn btn-primary btn-block btn-lg">
              <span>Proceder al Checkout</span> &rarr;
            </button>

            <div class="secure-badge">
              <span>Compra 100% Protegida y Cifrada</span>
            </div>
          </div>
        </aside>

      </div>

    </div>
  </div>
</BaseLayout>

<style>
  .cart-page {
    padding: var(--spacing-xl) 0 var(--spacing-2xl);
  }

  .cart-hero {
    margin-bottom: var(--spacing-xl);
  }

  .cart-hero h1 {
    margin: 0 0 0.25rem 0;
    font-size: 1.85rem;
    color: var(--color-text);
  }

  .cart-hero p {
    margin: 0;
    color: var(--color-text-muted);
  }

  /* Empty State */
  .empty-cart-card {
    text-align: center;
    padding: var(--spacing-2xl) var(--spacing-lg);
    background: var(--color-surface);
    max-width: 550px;
    margin: var(--spacing-xl) auto;
  }

  .empty-icon {
    font-size: 3.5rem;
    margin-bottom: 0.5rem;
  }

  .empty-cart-card h2 {
    margin: 0 0 0.5rem 0;
  }

  .empty-cart-card p {
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-lg);
  }

  /* Layout */
  .cart-layout {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: var(--spacing-xl);
    align-items: start;
  }

  .cart-items-card {
    padding: var(--spacing-lg);
    background: var(--color-surface);
    margin-bottom: var(--spacing-md);
  }

  .cart-items-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: var(--spacing-md);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--spacing-md);
  }

  .items-count-title {
    font-size: 1.1rem;
    font-weight: 700;
  }

  .btn-text-danger {
    color: #ef4444;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .btn-text-danger:hover {
    text-decoration: underline;
  }

  .cart-items-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  /* Fila de Libro en el Carrito */
  .cart-item-row {
    display: grid;
    grid-template-columns: 80px 1fr auto auto;
    gap: var(--spacing-md);
    align-items: center;
    padding-bottom: var(--spacing-md);
    border-bottom: 1px solid var(--color-border);
  }

  .cart-item-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .cart-item-thumb {
    width: 80px;
    height: 105px;
    background: #f1f5f9;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .cart-item-thumb img {
    max-height: 95px;
    object-fit: contain;
  }

  .cart-item-info h4 {
    margin: 0 0 0.2rem 0;
    font-size: 1rem;
  }

  .cart-item-info a:hover {
    color: var(--color-primary);
  }

  .cart-item-author {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    margin: 0 0 0.4rem 0;
  }

  .cart-item-unit-price {
    font-size: 0.88rem;
    color: var(--color-text);
  }

  .qty-widget {
    display: inline-flex;
    align-items: center;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .qty-btn-sm {
    width: 1.85rem;
    height: 1.85rem;
    background: var(--color-background);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.9rem;
  }

  .qty-btn-sm:hover {
    background: #e2e8f0;
  }

  .qty-val-sm {
    width: 2.2rem;
    text-align: center;
    font-size: 0.88rem;
    font-weight: 700;
  }

  .cart-item-subtotal-col {
    text-align: right;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.35rem;
  }

  .item-total-price {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--color-primary);
  }

  .remove-item-btn {
    color: #ef4444;
    font-size: 0.78rem;
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
  }

  .remove-item-btn:hover {
    text-decoration: underline;
  }

  /* Shipping Banner */
  .shipping-banner {
    padding: var(--spacing-md);
    background: var(--color-surface);
  }

  .shipping-info-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .shipping-truck {
    font-size: 1.25rem;
  }

  .shipping-msg {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .progress-track {
    height: 8px;
    background: var(--color-border);
    border-radius: 9999px;
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    background: #10b981;
    border-radius: 9999px;
    transition: width 0.3s ease;
  }

  /* Summary Card */
  .summary-card {
    padding: var(--spacing-lg);
    background: var(--color-surface);
    position: sticky;
    top: 5rem;
  }

  .summary-card h3 {
    margin: 0 0 var(--spacing-md) 0;
    padding-bottom: var(--spacing-sm);
    border-bottom: 1px solid var(--color-border);
    font-size: 1.15rem;
  }

  .summary-breakdown {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin-bottom: var(--spacing-lg);
  }

  .breakdown-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.92rem;
  }

  .row-label {
    color: var(--color-text-muted);
  }

  .row-val {
    font-weight: 600;
    color: var(--color-text);
  }

  .discount-row {
    color: #059669;
  }

  .row-val-discount {
    font-weight: 700;
    color: #059669;
  }

  .breakdown-sep {
    height: 1px;
    background: var(--color-border);
    margin-block: 0.35rem;
  }

  .total-row {
    font-size: 1.15rem;
  }

  .total-label {
    font-weight: 700;
    color: var(--color-text);
  }

  .total-val {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--color-primary);
  }

  /* Coupon */
  .coupon-section {
    margin-bottom: var(--spacing-lg);
    padding-top: var(--spacing-sm);
  }

  .coupon-label {
    display: block;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 0.4rem;
  }

  .coupon-input-box {
    display: flex;
    gap: 0.5rem;
  }

  .coupon-field {
    text-transform: uppercase;
    font-size: 0.88rem;
  }

  .coupon-alert {
    margin-top: 0.4rem;
    font-size: 0.8rem;
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-sm);
  }

  .coupon-alert.success {
    background: #d1fae5;
    color: #065f46;
  }

  .coupon-alert.error {
    background: #fee2e2;
    color: #991b1b;
  }

  .btn-lg {
    padding: 0.85rem 1rem;
    font-size: 1.05rem;
  }

  .secure-badge {
    text-align: center;
    margin-top: var(--spacing-md);
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 850px) {
    .cart-layout {
      grid-template-columns: 1fr;
    }

    .summary-card {
      position: static;
    }
  }

  @media (max-width: 550px) {
    .cart-item-row {
      grid-template-columns: 60px 1fr;
      gap: 0.75rem;
    }

    .cart-item-subtotal-col {
      grid-column: 1 / -1;
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      padding-top: 0.5rem;
      border-top: 1px dashed var(--color-border);
    }
  }
</style>

<script>
  import { cartService } from '../services/cart.js';

  const emptyView = document.getElementById('cart-empty-view') as HTMLElement;
  const contentView = document.getElementById('cart-content-view') as HTMLElement;
  const itemsContainer = document.getElementById('cart-items-container') as HTMLElement;
  const itemsTitle = document.getElementById('cart-items-title') as HTMLElement;
  const clearAllBtn = document.getElementById('clear-all-cart-btn') as HTMLElement;

  const subtotalEl = document.getElementById('summary-subtotal') as HTMLElement;
  const discountRow = document.getElementById('discount-row') as HTMLElement;
  const discountName = document.getElementById('discount-name') as HTMLElement;
  const discountEl = document.getElementById('summary-discount') as HTMLElement;
  const shippingEl = document.getElementById('summary-shipping') as HTMLElement;
  const totalEl = document.getElementById('summary-total') as HTMLElement;

  const shippingMsg = document.getElementById('shipping-msg-text') as HTMLElement;
  const shippingProgressBar = document.getElementById('shipping-progress-bar') as HTMLElement;

  const couponInput = document.getElementById('coupon-input') as HTMLInputElement;
  const applyCouponBtn = document.getElementById('apply-coupon-btn') as HTMLButtonElement;
  const couponAlert = document.getElementById('coupon-alert') as HTMLElement;
  const checkoutBtn = document.getElementById('proceed-checkout-btn') as HTMLButtonElement;

  function renderCart() {
    const items = cartService.getItems();
    const count = cartService.getCount();

    if (items.length === 0) {
      if (emptyView) emptyView.style.display = 'block';
      if (contentView) contentView.style.display = 'none';
      return;
    }

    if (emptyView) emptyView.style.display = 'none';
    if (contentView) contentView.style.display = 'grid';

    if (itemsTitle) {
      itemsTitle.textContent = `Artículos en el carrito (${count})`;
    }

    // Renderizar filas de libros
    if (itemsContainer) {
      itemsContainer.innerHTML = items.map((item) => `
        <div class="cart-item-row" data-id="${item.id}">
          <div class="cart-item-thumb">
            <img src="${item.imagen}" alt="${item.titulo}" />
          </div>

          <div class="cart-item-info">
            <h4><a href="/producto/${item.id}">${item.titulo}</a></h4>
            <p class="cart-item-author">${item.autor}</p>
            <span class="cart-item-unit-price">$${Number(item.precio).toFixed(2)} MXN c/u</span>
          </div>

          <div class="qty-widget">
            <button type="button" class="qty-btn-sm btn-minus" data-id="${item.id}" aria-label="Restar">−</button>
            <span class="qty-val-sm">${item.cantidad}</span>
            <button type="button" class="qty-btn-sm btn-plus" data-id="${item.id}" aria-label="Sumar">+</button>
          </div>

          <div class="cart-item-subtotal-col">
            <span class="item-total-price">$${(Number(item.precio) * Number(item.cantidad)).toFixed(2)} MXN</span>
            <button type="button" class="remove-item-btn btn-remove" data-id="${item.id}">
              Eliminar
            </button>
          </div>
        </div>
      `).join('');

      // Eventos de botones (+, -, eliminar)
      itemsContainer.querySelectorAll('.btn-minus').forEach((b) => {
        b.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLElement).dataset.id;
          const current = items.find((i) => String(i.id) === String(id));
          if (current) {
            cartService.updateQuantity(id, current.cantidad - 1);
            renderCart();
          }
        });
      });

      itemsContainer.querySelectorAll('.btn-plus').forEach((b) => {
        b.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLElement).dataset.id;
          const current = items.find((i) => String(i.id) === String(id));
          if (current) {
            try {
              cartService.updateQuantity(id, current.cantidad + 1);
              renderCart();
            } catch (err: any) {
              if ((window as any).showToast) (window as any).showToast(err.message, 'warning');
            }
          }
        });
      });

      itemsContainer.querySelectorAll('.btn-remove').forEach((b) => {
        b.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLElement).dataset.id;
          cartService.removeItem(id);
          renderCart();
        });
      });
    }

    // Actualizar resumen financiero
    const fin = cartService.getFinancials();
    if (subtotalEl) subtotalEl.textContent = `$${fin.subtotal.toFixed(2)} MXN`;
    if (shippingEl) shippingEl.textContent = fin.shipping === 0 ? 'GRATIS' : `$${fin.shipping.toFixed(2)} MXN`;
    if (totalEl) totalEl.textContent = `$${fin.total.toFixed(2)} MXN`;

    if (fin.discount > 0 && discountRow) {
      discountRow.style.display = 'flex';
      if (discountName) discountName.textContent = fin.coupon || 'Cupón';
      if (discountEl) discountEl.textContent = `-$${fin.discount.toFixed(2)} MXN`;
    } else if (discountRow) {
      discountRow.style.display = 'none';
    }

    // Banner de envío gratis ($999 meta)
    if (fin.subtotal >= 999) {
      if (shippingMsg) shippingMsg.textContent = '¡Felicidades! Tienes Envío GRATIS en esta compra.';
      if (shippingProgressBar) shippingProgressBar.style.width = '100%';
    } else {
      const remaining = 999 - fin.subtotal;
      const percent = Math.min(100, Math.round((fin.subtotal / 999) * 100));
      if (shippingMsg) shippingMsg.textContent = `Faltan $${remaining.toFixed(2)} MXN para obtener Envío GRATIS`;
      if (shippingProgressBar) shippingProgressBar.style.width = `${percent}%`;
    }
  }

  // Inicializar
  renderCart();

  // Escuchar eventos globales de carrito
  window.addEventListener('cart-updated', renderCart);

  // Vaciar carrito
  if (clearAllBtn) {
    clearAllBtn.addEventListener('click', () => {
      if (confirm('¿Estás seguro de que deseas vaciar tu carrito?')) {
        cartService.clearCart();
        renderCart();
      }
    });
  }

  // Aplicar cupón
  if (applyCouponBtn && couponInput) {
    // Si ya había cupón activo, prellenar
    const activeCoupon = cartService.getCoupon();
    if (activeCoupon) {
      couponInput.value = activeCoupon;
    }

    applyCouponBtn.addEventListener('click', () => {
      const code = couponInput.value.trim();
      const res = cartService.applyCoupon(code);
      if (couponAlert) {
        couponAlert.textContent = res.message;
        couponAlert.className = `coupon-alert ${res.valid ? 'success' : 'error'}`;
        couponAlert.style.display = 'block';
      }
      renderCart();
    });
  }

  // Continuar al Checkout
  if (checkoutBtn) {
    checkoutBtn.addEventListener('click', () => {
      window.location.href = '/checkout';
    });
  }
</script>
