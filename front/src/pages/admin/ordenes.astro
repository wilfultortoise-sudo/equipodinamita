---
import AdminLayout from '../../layouts/AdminLayout.astro';
const pageTitle = "Gestión de Órdenes | BiblioTech Store";
---

<AdminLayout pageTitle={pageTitle} >

  <main class="admin-page">

    <section class="admin-header">
      <div>
        <span class="admin-label">BIBLIOTECH STORE</span>
        <div style="display: flex; align-items: center; gap: 15px; flex-wrap: wrap;">
          <h1>Gestión de Órdenes</h1>
          <span id="ws-status-badge" class="ws-badge ws-connecting">🟡 Conectando WS...</span>
        </div>
        <p>
          Consulta y supervisa las ventas y pedidos en tiempo real con WebSocket.
        </p>
      </div>

      <a href="/admin" class="back-button">
        ← Panel Admin
      </a>
    </section>

    <!-- Verificación de Seguridad y Rol ADMIN (Rutas Protegidas - RP) -->
    <div id="admin-auth-guard" class="auth-guard-card" style="display: none;">
      <div class="guard-icon">
        <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
      </div>
      <h2 id="guard-title">Acceso Restringido para Administradores</h2>
      <p id="guard-message">Debes iniciar sesión con una cuenta autorizada con rol ADMIN para acceder a la Gestión de Órdenes.</p>
      <div class="guard-actions">
        <a href="/login?redirect=/admin/ordenes&role_required=ADMIN" class="btn-guard-primary" id="guard-login-btn">Iniciar Sesión como Administrador</a>
        <a href="/" class="btn-guard-outline">Volver a la Tienda</a>
      </div>
    </div>

    <!-- Cargando -->
    <section id="loading" class="message-card">
      Cargando órdenes...
    </section>

    <!-- Error -->
    <section
      id="error"
      class="message-card error"
      style="display:none;"
    >
      <h2>Error</h2>
      <p id="error-message"></p>

      <a href="/admin" class="back-button">
        Volver al panel
      </a>
    </section>

    <!-- Contenido -->
    <section
      id="orders-content"
      style="display:none;"
    >

      <div class="orders-summary">
        <div>
          <span>Total de órdenes</span>
          <strong id="total-orders">0</strong>
        </div>

        <button
          id="refresh-button"
          class="refresh-button"
          type="button"
        >
          ↻ Actualizar
        </button>
      </div>

      <div id="orders-container"></div>

    </section>

  </main>


  <script>

    const API_URL =
      import.meta.env.PUBLIC_API_URL ||
      'http://localhost:4000/';

    const loadingElement =
      document.getElementById('loading');

    const errorElement =
      document.getElementById('error');

    const errorMessageElement =
      document.getElementById('error-message');

    const contentElement =
      document.getElementById('orders-content');

    const ordersContainer =
      document.getElementById('orders-container');

    const totalOrdersElement =
      document.getElementById('total-orders');

    const refreshButton =
      document.getElementById('refresh-button');


    function mostrarError(mensaje: string): void {

      if (loadingElement) {
        loadingElement.style.display = 'none';
      }

      if (contentElement) {
        contentElement.style.display = 'none';
      }

      if (errorElement) {
        errorElement.style.display = 'block';
      }

      if (errorMessageElement) {
        errorMessageElement.textContent = mensaje;
      }
    }


    function obtenerTextoEstado(status: string): string {

      const estados: Record<string, string> = {
        PENDIENTE: 'Pendiente',
        PAGADO: 'Pagado',
        PREPARANDO: 'Preparando',
        ENVIADO: 'Enviado',
        ENTREGADO: 'Entregado',
        CANCELADO: 'Cancelado'
      };

      return estados[status] || status;
    }


    function obtenerClaseEstado(status: string): string {

      const clases: Record<string, string> = {
        PENDIENTE: 'pendiente',
        PAGADO: 'pagado',
        PREPARANDO: 'preparando',
        ENVIADO: 'enviado',
        ENTREGADO: 'entregado',
        CANCELADO: 'cancelado'
      };

      return clases[status] || '';
    }


    function formatearFecha(fecha: string): string {

      const fechaObjeto = new Date(fecha);

      if (Number.isNaN(fechaObjeto.getTime())) {
        return fecha;
      }

      return fechaObjeto.toLocaleString('es-MX', {
        dateStyle: 'medium',
        timeStyle: 'short'
      });
    }


    function formatearMoneda(valor: number): string {

      return Number(valor).toLocaleString(
        'es-MX',
        {
          style: 'currency',
          currency: 'MXN'
        }
      );
    }


    async function cambiarEstado(
      id: number,
      nuevoEstado: string
    ): Promise<void> {

      const token =
        localStorage.getItem('auth_token');

      if (!token) {
        window.location.href =
          '/login?redirect=/admin/ordenes';

        return;
      }

      const mutation = `
        mutation ActualizarEstadoPedido(
          $id: ID!
          $status: StatusPedido!
        ) {
          actualizarEstadoPedido(
            id: $id
            status: $status
          ) {
            id
            folio
            status
          }
        }
      `;

      try {

        const response = await fetch(API_URL, {

          method: 'POST',

          headers: {
            'Content-Type': 'application/json',
            'Authorization': 'Bearer ' + token
          },

          body: JSON.stringify({
            query: mutation,
            variables: {
              id,
              status: nuevoEstado
            }
          })

        });

        if (!response.ok) {
          throw new Error(
            `Error HTTP ${response.status}`
          );
        }

        const result = await response.json();

        if (result.errors) {

          const mensaje: string =
            result.errors[0]?.message ||
            'No se pudo actualizar el estado.';

          throw new Error(mensaje);
        }

        await cargarOrdenes();

      } catch (error: unknown) {

        console.error(
          'Error actualizando pedido:',
          error
        );

        const mensaje =
          error instanceof Error
            ? error.message
            : 'No se pudo actualizar el pedido.';

        alert(mensaje);
      }
    }


    function crearSelectorEstado(
      pedidoId: number,
      estadoActual: string
    ): HTMLSelectElement {

      const select =
        document.createElement('select');

      select.className =
        'status-select';

      const estados = [
        'PENDIENTE',
        'PAGADO',
        'PREPARANDO',
        'ENVIADO',
        'ENTREGADO',
        'CANCELADO'
      ];

      estados.forEach((estado) => {

        const option =
          document.createElement('option');

        option.value = estado;
        option.textContent =
          obtenerTextoEstado(estado);

        if (estado === estadoActual) {
          option.selected = true;
        }

        select.appendChild(option);
      });


      select.addEventListener(
        'change',
        async () => {

          const nuevoEstado =
            select.value;

          await cambiarEstado(
            pedidoId,
            nuevoEstado
          );

        }
      );


      return select;
    }


    function crearPedidoHTML(pedido: any): HTMLElement {

      const card =
        document.createElement('article');

      card.className = 'order-card';


      const header =
        document.createElement('div');

      header.className = 'order-header';


      const orderInfo =
        document.createElement('div');

      const folio =
        document.createElement('h2');

      folio.textContent =
        pedido.folio;

      const date =
        document.createElement('p');

      date.textContent =
        formatearFecha(pedido.fecha);

      orderInfo.appendChild(folio);
      orderInfo.appendChild(date);


      const statusContainer =
        document.createElement('div');

      statusContainer.className =
        'status-container';


      const statusBadge =
        document.createElement('span');

      statusBadge.className =
        `status-badge ${obtenerClaseEstado(pedido.status)}`;

      statusBadge.textContent =
        obtenerTextoEstado(pedido.status);


      const statusSelect =
        crearSelectorEstado(
          Number(pedido.id),
          pedido.status
        );


      statusContainer.appendChild(statusBadge);
      statusContainer.appendChild(statusSelect);

      header.appendChild(orderInfo);
      header.appendChild(statusContainer);


      // Cliente
      const customer =
        document.createElement('div');

      customer.className =
        'customer-section';

      customer.innerHTML = `
        <h3>Cliente</h3>
        <p>
          <strong>${pedido.nombreCliente || 'Sin nombre'}</strong>
        </p>
        <p>${pedido.emailCliente || 'Sin correo'}</p>
      `;


      // Información del pedido
      const info =
        document.createElement('div');

      info.className =
        'order-info-grid';

      info.innerHTML = `
        <div>
          <span>Subtotal</span>
          <strong>${formatearMoneda(pedido.subtotal)}</strong>
        </div>

        <div>
          <span>Envío</span>
          <strong>${formatearMoneda(pedido.envio)}</strong>
        </div>

        <div>
          <span>Total</span>
          <strong>${formatearMoneda(pedido.total)}</strong>
        </div>

        <div>
          <span>Método de pago</span>
          <strong>${pedido.metodoPago || 'No especificado'}</strong>
        </div>
      `;


      // Productos
      const productsSection =
        document.createElement('div');

      productsSection.className =
        'products-section';


      const productsTitle =
        document.createElement('h3');

      productsTitle.textContent =
        'Productos';

      productsSection.appendChild(productsTitle);


      if (
        pedido.detalles &&
        pedido.detalles.length > 0
      ) {

        pedido.detalles.forEach((detalle: any) => {

          const product =
            document.createElement('div');

          product.className =
            'product-row';


          const productName =
            detalle.producto?.titulo ||
            'Producto';


          product.innerHTML = `
            <div class="product-data">
              <strong>${productName}</strong>
              <span>
                Cantidad: ${detalle.cantidad}
              </span>
            </div>

            <div class="product-price">
              ${formatearMoneda(detalle.subtotal)}
            </div>
          `;

          productsSection.appendChild(product);

        });

      } else {

        const empty =
          document.createElement('p');

        empty.textContent =
          'No hay productos registrados.';

        productsSection.appendChild(empty);
      }


      // Dirección
      const address =
        document.createElement('div');

      address.className =
        'address-section';

      address.innerHTML = `
        <h3>Dirección de envío</h3>
        <p>
          ${pedido.direccionEnvio || 'No especificada'}
        </p>
      `;


      card.appendChild(header);
      card.appendChild(customer);
      card.appendChild(info);
      card.appendChild(productsSection);
      card.appendChild(address);


      return card;
    }


    async function cargarOrdenes(): Promise<void> {

      const token =
        localStorage.getItem('auth_token');

      const userRaw =
        localStorage.getItem('auth_user');

      const authGuardEl = document.getElementById('admin-auth-guard');
      const guardTitleEl = document.getElementById('guard-title');
      const guardMsgEl = document.getElementById('guard-message');
      const guardLoginBtnEl = document.getElementById('guard-login-btn');
      const headerSection = document.querySelector('.admin-header') as HTMLElement;

      if (guardLoginBtnEl) {
        guardLoginBtnEl.addEventListener('click', (e) => {
          e.preventDefault();
          localStorage.removeItem('auth_token');
          localStorage.removeItem('auth_user');
          window.location.href = '/login?redirect=/admin/ordenes&role_required=ADMIN';
        });
      }

      function blockAccess(isLoggedIn: boolean, usr?: any) {
        if (loadingEl) loadingEl.style.display = 'none';
        if (contentEl) contentEl.style.display = 'none';
        if (headerSection) headerSection.style.display = 'none';
        if (authGuardEl) {
          authGuardEl.style.display = 'block';
          if (!isLoggedIn) {
            if (guardTitleEl) guardTitleEl.textContent = 'Acceso Restringido: Inicia Sesión';
            if (guardMsgEl) guardMsgEl.textContent = 'Se requiere autenticación con privilegios de Administrador para gestionar órdenes en tiempo real.';
            if (guardLoginBtnEl) {
              guardLoginBtnEl.textContent = 'Iniciar Sesión como Administrador';
              guardLoginBtnEl.setAttribute('href', '/login?redirect=/admin/ordenes&role_required=ADMIN');
            }
          } else {
            if (guardTitleEl) guardTitleEl.textContent = 'Acceso Denegado: Rol no Autorizado (RP)';
            if (guardMsgEl) guardMsgEl.textContent = `Hola ${usr?.nombre || 'Usuario'}. Tu cuenta (${usr?.email || ''}) tiene rol "${usr?.rol || 'CLIENTE'}". Esta sección está reservada exclusivamente para Administradores de BiblioTech.`;
            if (guardLoginBtnEl) {
              guardLoginBtnEl.textContent = 'Cambiar a Cuenta Administrador';
              guardLoginBtnEl.setAttribute('href', '/login?redirect=/admin/ordenes&role_required=ADMIN');
            }
          }
        }
      }

      // --------------------------------------------------
      // Verificar sesión
      // --------------------------------------------------

      if (!token || !userRaw) {
        blockAccess(false);
        return;
      }


      let usuario: {
        id?: number;
        nombre?: string;
        email?: string;
        rol?: string;
      };


      try {

        usuario =
          JSON.parse(userRaw);

      } catch {

        localStorage.removeItem('auth_token');
        localStorage.removeItem('auth_user');
        blockAccess(false);
        return;
      }


      // --------------------------------------------------
      // Verificar ADMIN (Rutas Protegidas - RP)
      // --------------------------------------------------

      if (usuario.rol !== 'ADMIN') {
        blockAccess(true, usuario);
        return;
      }


      const query = `
        query ObtenerPedidosAdmin {

          pedidos {

            id
            folio
            fecha

            subtotal
            envio
            total

            status
            metodoPago
            direccionEnvio

            nombreCliente
            emailCliente

            usuarioId

            detalles {

              id
              cantidad
              precioUnitario
              subtotal

              producto {
                id
                titulo
                autor
                imagen
              }

            }

          }

        }
      `;


      try {

        const response =
          await fetch(API_URL, {

            method: 'POST',

            headers: {
              'Content-Type': 'application/json',
              'Authorization':
                'Bearer ' + token
            },

            body: JSON.stringify({
              query
            })

          });


        if (!response.ok) {

          throw new Error(
            `Error HTTP ${response.status}`
          );

        }


        const result =
          await response.json();


        if (result.errors) {

          const mensaje: string =
            result.errors[0]?.message ||
            'No se pudieron obtener las órdenes.';

          mostrarError(mensaje);

          return;
        }


        const pedidos =
          result.data?.pedidos || [];


        if (totalOrdersElement) {

          totalOrdersElement.textContent =
            String(pedidos.length);

        }


        if (ordersContainer) {

          ordersContainer.innerHTML = '';

          if (pedidos.length === 0) {

            const empty =
              document.createElement('div');

            empty.className =
              'empty-card';

            empty.textContent =
              'No hay pedidos registrados.';

            ordersContainer.appendChild(empty);

          } else {

            pedidos.forEach((pedido: any) => {

              const pedidoElement =
                crearPedidoHTML(pedido);

              ordersContainer.appendChild(
                pedidoElement
              );

            });

          }

        }


        if (loadingElement) {
          loadingElement.style.display =
            'none';
        }

        if (contentElement) {
          contentElement.style.display =
            'block';
        }


      } catch (error: unknown) {

        console.error(
          'Error cargando órdenes:',
          error
        );


        const mensaje =
          error instanceof Error
            ? error.message
            : 'No fue posible cargar las órdenes.';

        mostrarError(mensaje);

      }

    }


    if (refreshButton) {

      refreshButton.addEventListener(
        'click',
        () => {
          cargarOrdenes();
        }
      );

    }


    // --------------------------------------------------
    // FASE 4: GraphQL Subscription pedidoCreado (WebSocket en tiempo real)
    // --------------------------------------------------
    function iniciarWebSocketSuscripcion(): void {
      const token = localStorage.getItem('auth_token') || '';
      const wsStatusBadge = document.getElementById('ws-status-badge');

      // Determinar endpoint WebSocket oficial
      let wsBase = 'ws://localhost:4000/graphql';
      try {
        if (API_URL.startsWith('https')) {
          wsBase = API_URL.replace('https', 'wss').replace(/\/$/, '') + '/graphql';
        } else if (API_URL.startsWith('http')) {
          const parsed = new URL(API_URL);
          wsBase = `ws://${parsed.hostname}:4000/graphql`;
        }
      } catch {}

      let socket: WebSocket | null = null;
      let reconnectTimer: any = null;

      function conectar() {
        try {
          socket = new WebSocket(wsBase, 'graphql-transport-ws');

          socket.onopen = () => {
            if (wsStatusBadge) {
              wsStatusBadge.className = 'ws-badge ws-connecting';
              wsStatusBadge.textContent = '🟡 Autenticando WS...';
            }
            // Handshake con subprotocolo graphql-transport-ws
            socket?.send(JSON.stringify({
              type: 'connection_init',
              payload: {
                authorization: token ? `Bearer ${token}` : ''
              }
            }));
          };

          socket.onmessage = (event) => {
            try {
              const data = JSON.parse(event.data);

              if (data.type === 'connection_ack') {
                if (wsStatusBadge) {
                  wsStatusBadge.className = 'ws-badge ws-online';
                  wsStatusBadge.textContent = '🟢 En vivo (WS Conectado)';
                }

                // Suscribirse en tiempo real al evento pedidoCreado
                socket?.send(JSON.stringify({
                  id: 'sub_pedidos_admin',
                  type: 'subscribe',
                  payload: {
                    query: `
                      subscription OnPedidoCreado {
                        pedidoCreado {
                          id
                          folio
                          fecha
                          subtotal
                          envio
                          total
                          status
                          metodoPago
                          direccionEnvio
                          nombreCliente
                          emailCliente
                          usuarioId
                          detalles {
                            id
                            cantidad
                            precioUnitario
                            subtotal
                            producto {
                              id
                              titulo
                              autor
                              imagen
                            }
                          }
                        }
                      }
                    `
                  }
                }));
              } else if (data.type === 'next' && data.payload?.data?.pedidoCreado) {
                const nuevoPedido = data.payload.data.pedidoCreado;
                recibirNuevoPedidoEnVivo(nuevoPedido);
              }
            } catch (err) {
              console.warn('[WS] Error interpretando mensaje:', err);
            }
          };

          socket.onclose = () => {
            if (wsStatusBadge) {
              wsStatusBadge.className = 'ws-badge ws-offline';
              wsStatusBadge.textContent = '🔴 WS Desconectado';
            }
            clearTimeout(reconnectTimer);
            reconnectTimer = setTimeout(conectar, 4000);
          };

          socket.onerror = () => {
            if (wsStatusBadge) {
              wsStatusBadge.className = 'ws-badge ws-offline';
              wsStatusBadge.textContent = '🔴 Reconectando WS...';
            }
          };
        } catch (e) {
          console.warn('[WS] Fallo al inicializar WebSocket:', e);
        }
      }

      function recibirNuevoPedidoEnVivo(pedido: any): void {
        if (!ordersContainer) return;

        // Remover mensaje de vacío si existía
        const emptyEl = ordersContainer.querySelector('.empty-card');
        if (emptyEl) emptyEl.remove();

        // Evitar duplicados
        const existingCard = ordersContainer.querySelector(`[data-order-folio="${pedido.folio}"]`);
        if (existingCard) return;

        // Crear tarjeta y animar su llegada en tiempo real
        const card = crearPedidoHTML(pedido);
        card.setAttribute('data-order-folio', pedido.folio);
        card.classList.add('new-order-pulse');

        // Insertar al inicio de la lista
        ordersContainer.insertBefore(card, ordersContainer.firstChild);

        // Actualizar contador
        if (totalOrdersElement) {
          const actual = Number(totalOrdersElement.textContent || 0);
          totalOrdersElement.textContent = String(actual + 1);
        }

        // Alerta visual Toast
        if ((window as any).showToast) {
          (window as any).showToast(`🔔 ¡Nueva orden recibida en vivo: ${pedido.folio}! Total: $${pedido.total} MXN`, 'success');
        }
      }

      conectar();
    }

    cargarOrdenes();
    iniciarWebSocketSuscripcion();
  </script>


  <style>

    /* Auth Guard (Rutas Protegidas - RP) */
    .auth-guard-card {
      max-width: 560px;
      margin: 4rem auto;
      text-align: center;
      padding: 3rem 2rem;
      background: white;
      border: 1px solid #e2e8f0;
      border-radius: 16px;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
    }

    .guard-icon {
      color: #dc2626;
      margin-bottom: 1.25rem;
    }

    .auth-guard-card h2 {
      margin: 0 0 0.75rem 0;
      font-size: 1.5rem;
      color: #1e293b;
    }

    .auth-guard-card p {
      color: #64748b;
      margin-bottom: 2rem;
      font-size: 0.95rem;
      line-height: 1.5;
    }

    .guard-actions {
      display: flex;
      justify-content: center;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .btn-guard-primary {
      display: inline-block;
      padding: 0.75rem 1.5rem;
      background: #2563eb;
      color: white;
      text-decoration: none;
      border-radius: 8px;
      font-weight: 600;
      font-size: 0.9rem;
      border: none;
      cursor: pointer;
      transition: background 0.2s;
    }

    .btn-guard-primary:hover {
      background: #1d4ed8;
    }

    .btn-guard-outline {
      display: inline-block;
      padding: 0.75rem 1.5rem;
      background: transparent;
      color: #475569;
      text-decoration: none;
      border-radius: 8px;
      font-weight: 600;
      font-size: 0.9rem;
      border: 1px solid #cbd5e1;
      cursor: pointer;
      transition: all 0.2s;
    }

    .btn-guard-outline:hover {
      background: #f1f5f9;
      color: #0f172a;
    }

    .admin-page {
      max-width: 1200px;
      margin: 0 auto;
      padding: 40px 20px 70px;
    }


    .admin-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 30px;
      margin-bottom: 30px;
    }


    .admin-label {
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 1.5px;
      opacity: .65;
    }


    .admin-header h1 {
      margin: 8px 0;
      font-size: 38px;
    }


    .admin-header p {
      margin: 0;
      opacity: .7;
    }


    .back-button,
    .refresh-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 11px 18px;
      border: none;
      border-radius: 10px;
      text-decoration: none;
      font-weight: 700;
      background: #111827;
      color: white;
      cursor: pointer;
    }


    .message-card {
      padding: 30px;
      border-radius: 16px;
      background: #f3f4f6;
      text-align: center;
    }


    .message-card.error {
      background: #fee2e2;
      color: #991b1b;
    }


    .message-card .back-button {
      margin-top: 15px;
    }


    .orders-summary {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 25px;
      padding: 20px;
      border-radius: 14px;
      background: white;
      box-shadow:
        0 4px 20px rgba(0, 0, 0, .06);
    }


    .orders-summary span {
