---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Panel Administrativo | BiblioTech Store">

  <main class="admin-page">

    <section class="admin-header">
      <div>
        <span class="admin-label">BIBLIOTECH STORE</span>
        <h1>Panel Administrativo</h1>
        <p>
          Administración general de la tienda, pedidos y estadísticas.
        </p>
      </div>

      <a href="/admin/ordenes" class="orders-button">
        Gestionar órdenes
      </a>
    </section>


    <!-- Estado de acceso -->
    <section id="access-loading" class="message-card">
      Verificando permisos...
    </section>


    <!-- Panel -->
    <section id="admin-content" style="display:none;">

      <div class="welcome-card">
        <div>
          <span>Administrador</span>
          <h2 id="admin-name">Cargando...</h2>
        </div>

        <div class="admin-badge">
          ADMIN
        </div>
      </div>


      <!-- KPIs -->
      <section class="kpi-grid">

        <article class="kpi-card">
          <div class="kpi-icon">💰</div>
          <div>
            <span>Ventas totales</span>
            <strong id="ventas-totales">$0.00</strong>
          </div>
        </article>


        <article class="kpi-card">
          <div class="kpi-icon">📦</div>
          <div>
            <span>Total de pedidos</span>
            <strong id="total-pedidos">0</strong>
          </div>
        </article>


        <article class="kpi-card">
          <div class="kpi-icon">👥</div>
          <div>
            <span>Clientes</span>
            <strong id="total-clientes">0</strong>
          </div>
        </article>


        <article class="kpi-card">
          <div class="kpi-icon">📚</div>
          <div>
            <span>Productos</span>
            <strong id="total-productos">0</strong>
          </div>
        </article>

      </section>


      <!-- Estados de pedidos -->
      <section class="status-section">

        <div class="section-title">
          <h2>Estado de pedidos</h2>
          <span>Resumen actual</span>
        </div>


        <div class="status-grid">

          <article class="status-card pending">
            <span>Pendientes</span>
            <strong id="pedidos-pendientes">0</strong>
          </article>


          <article class="status-card preparing">
            <span>Preparando</span>
            <strong id="pedidos-preparando">0</strong>
          </article>


          <article class="status-card shipped">
            <span>Enviados</span>
            <strong id="pedidos-enviados">0</strong>
          </article>


          <article class="status-card delivered">
            <span>Entregados</span>
            <strong id="pedidos-entregados">0</strong>
          </article>

        </div>

      </section>


      <!-- Acciones rápidas -->
      <section class="quick-section">

        <div class="section-title">
          <h2>Acciones rápidas</h2>
        </div>

        <div class="quick-grid">

            

          <a href="/admin/ordenes" class="quick-card">
            <span class="quick-icon">📦</span>
            <div>
              <strong>Gestionar órdenes</strong>
              <p>Consultar pedidos y actualizar su estado.</p>
            </div>
          </a>
          


          <a href="/catalogo" class="quick-card">
            <span class="quick-icon">📚</span>
            <div>
              <strong>Ver catálogo</strong>
              <p>Consultar los productos disponibles.</p>
            </div>
          </a>

          <a href="/admin/productos" class="quick-card">
              <span>📚</span>
              <div>
                <strong>Gestionar Productos</strong>
                <p>Agregar, modificar y eliminar productos</p>
              </div>
            </a>

        </div>

      </section>

    </section>


    <!-- Error de acceso -->
    <section id="access-error" class="message-card error" style="display:none;">
      <h2>Acceso denegado</h2>
      <p id="access-error-message">
        No tienes permisos para acceder a esta sección.
      </p>

      <a href="/" class="back-button">
        Volver al inicio
      </a>
    </section>

  </main>


  <script>
  const API_URL =
    import.meta.env.PUBLIC_API_URL ||
    'http://localhost:4000/';

  const loadingElement = document.getElementById('access-loading');
  const contentElement = document.getElementById('admin-content');
  const errorElement = document.getElementById('access-error');
  const errorMessage = document.getElementById('access-error-message');
  const adminNameElement = document.getElementById('admin-name');

  function mostrarError(mensaje: string): void {
    if (loadingElement) {
      loadingElement.style.display = 'none';
    }

    if (contentElement) {
      contentElement.style.display = 'none';
    }

    if (errorElement) {
      errorElement.style.display = 'block';
    }

    if (errorMessage) {
      errorMessage.textContent = mensaje;
    }
  }

  async function cargarPanelAdmin(): Promise<void> {

    const token = localStorage.getItem('auth_token');
    const userRaw = localStorage.getItem('auth_user');

    // --------------------------------------------------
    // 1. Verificar sesión local
    // --------------------------------------------------

    if (!token || !userRaw) {
      window.location.href = '/login?redirect=/admin';
      return;
    }

    let usuario: {
      id?: number;
      nombre?: string;
      email?: string;
      rol?: string;
    };

    try {
      usuario = JSON.parse(userRaw);
    } catch {
      localStorage.removeItem('auth_token');
      localStorage.removeItem('auth_user');

      window.location.href = '/login?redirect=/admin';
      return;
    }

    // --------------------------------------------------
    // 2. Verificación rápida del rol
    // --------------------------------------------------

    if (usuario.rol !== 'ADMIN') {
      mostrarError(
        'Tu cuenta no tiene permisos de administrador.'
      );
      return;
    }

    if (adminNameElement) {
      adminNameElement.textContent =
        usuario.nombre || 'Administrador';
    }

    // --------------------------------------------------
    // 3. Verificación REAL contra el backend
    // --------------------------------------------------

    const query = `
      query ObtenerAdminKPIs {
        adminKPIs {
          ventasTotales
          totalPedidos
          totalClientes
          totalProductos
          pedidosPendientes
          pedidosPreparando
          pedidosEnviados
          pedidosEntregados
        }
      }
    `;

    try {

      const response = await fetch(API_URL, {
        method: 'POST',

        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer ' + token
        },

        body: JSON.stringify({
          query
        })
      });

      if (!response.ok) {
        throw new Error(
          `Error HTTP ${response.status}: ${response.statusText}`
        );
      }

      const result = await response.json();

      // ------------------------------------------------
      // Error GraphQL
      // ------------------------------------------------

      if (result.errors) {

        const mensaje: string =
          result.errors[0]?.message ||
          'No tienes permisos para acceder al panel.';

        if (
          mensaje.includes('No autorizado') ||
          mensaje.includes('Acceso denegado')
        ) {
          mostrarError(mensaje);
          return;
        }

        throw new Error(mensaje);
      }

      const kpis = result.data?.adminKPIs;

      if (!kpis) {
        throw new Error(
          'No se recibieron los indicadores del servidor.'
        );
      }

      // ------------------------------------------------
      // 4. Mostrar KPIs
      // ------------------------------------------------

      const ventasElement =
        document.getElementById('ventas-totales');

      if (ventasElement) {
        ventasElement.textContent =
          Number(kpis.ventasTotales).toLocaleString(
            'es-MX',
            {
              style: 'currency',
              currency: 'MXN'
            }
          );
      }

      const pedidosElement =
        document.getElementById('total-pedidos');

      if (pedidosElement) {
        pedidosElement.textContent =
          String(kpis.totalPedidos);
      }

      const clientesElement =
        document.getElementById('total-clientes');

      if (clientesElement) {
        clientesElement.textContent =
          String(kpis.totalClientes);
      }

      const productosElement =
        document.getElementById('total-productos');

      if (productosElement) {
        productosElement.textContent =
          String(kpis.totalProductos);
      }

      const pendientesElement =
        document.getElementById('pedidos-pendientes');

      if (pendientesElement) {
        pendientesElement.textContent =
          String(kpis.pedidosPendientes);
      }

      const preparandoElement =
        document.getElementById('pedidos-preparando');

      if (preparandoElement) {
        preparandoElement.textContent =
          String(kpis.pedidosPreparando);
      }

      const enviadosElement =
        document.getElementById('pedidos-enviados');

      if (enviadosElement) {
        enviadosElement.textContent =
          String(kpis.pedidosEnviados);
      }

      const entregadosElement =
        document.getElementById('pedidos-entregados');

      if (entregadosElement) {
        entregadosElement.textContent =
          String(kpis.pedidosEntregados);
      }

      // ------------------------------------------------
      // 5. Mostrar panel
      // ------------------------------------------------

      if (loadingElement) {
        loadingElement.style.display = 'none';
      }

      if (contentElement) {
        contentElement.style.display = 'block';
      }

    } catch (error: unknown) {

      console.error(
        'Error cargando panel ADMIN:',
        error
      );

      const mensaje =
        error instanceof Error
          ? error.message
          : 'No fue posible cargar el panel administrativo.';

      mostrarError(mensaje);
    }
  }

  cargarPanelAdmin();
</script>

  <style>

    .admin-page {
      max-width: 1200px;
      margin: 0 auto;
      padding: 40px 20px 70px;
    }


    .admin-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 30px;
      margin-bottom: 30px;
    }


    .admin-label {
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 1.5px;
      opacity: .65;
    }


    .admin-header h1 {
      margin: 8px 0;
      font-size: 38px;
    }


    .admin-header p {
      margin: 0;
      opacity: .7;
    }


    .orders-button,
    .back-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 12px 20px;
      border-radius: 10px;
      text-decoration: none;
      font-weight: 700;
      background: #111827;
      color: white;
    }


    .message-card {
      padding: 30px;
      border-radius: 16px;
      background: #f3f4f6;
      text-align: center;
    }


    .message-card.error {
      background: #fee2e2;
      color: #991b1b;
    }


    .message-card.error .back-button {
      margin-top: 15px;
    }


    .welcome-card {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 25px;
      margin-bottom: 25px;
      border-radius: 16px;
      background: #111827;
      color: white;
    }


    .welcome-card span {
      opacity: .7;
      font-size: 14px;
    }


    .welcome-card h2 {
      margin: 5px 0 0;
    }


    .admin-badge {
      padding: 8px 14px;
      border-radius: 20px;
      background: white;
      color: #111827;
      font-size: 12px;
      font-weight: 800;
    }


    .kpi-grid {
      display: grid;
      grid-template-columns:
        repeat(4, minmax(0, 1fr));
      gap: 18px;
      margin-bottom: 40px;
    }


    .kpi-card {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 22px;
      border-radius: 16px;
      background: white;
      box-shadow:
        0 4px 20px rgba(0, 0, 0, .07);
    }


    .kpi-icon {
      width: 50px;
      height: 50px;
      display: grid;
      place-items: center;
      border-radius: 12px;
      background: #f3f4f6;
      font-size: 24px;
    }


    .kpi-card span {
      display: block;
      font-size: 13px;
      opacity: .65;
      margin-bottom: 5px;
    }


    .kpi-card strong {
      font-size: 25px;
    }


    .section-title {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 18px;
    }


    .section-title h2 {
      margin: 0;
    }


    .section-title span {
      opacity: .6;
      font-size: 14px;
    }


    .status-section {
      margin-bottom: 40px;
    }


    .status-grid {
      display: grid;
      grid-template-columns:
        repeat(4, minmax(0, 1fr));
      gap: 16px;
    }


    .status-card {
      padding: 22px;
      border-radius: 14px;
      background: #f9fafb;
    }


    .status-card span {
      display: block;
      margin-bottom: 8px;
      font-size: 14px;
    }


    .status-card strong {
      font-size: 30px;
    }


    .quick-grid {
      display: grid;
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
      gap: 18px;
    }


    .quick-card {
      display: flex;
      align-items: center;
      gap: 18px;
      padding: 22px;
      border-radius: 16px;
      background: white;
      color: inherit;
      text-decoration: none;
      box-shadow:
        0 4px 20px rgba(0, 0, 0, .06);
      transition: transform .2s;
    }


    .quick-card:hover {
      transform: translateY(-2px);
    }


    .quick-icon {
      font-size: 30px;
    }


    .quick-card strong {
      display: block;
      margin-bottom: 5px;
    }


    .quick-card p {
      margin: 0;
      opacity: .65;
      font-size: 14px;
    }


    @media (max-width: 850px) {

      .kpi-grid,
      .status-grid {
        grid-template-columns:
          repeat(2, minmax(0, 1fr));
      }

      .admin-header {
        flex-direction: column;
        align-items: flex-start;
      }

    }


    @media (max-width: 550px) {

      .kpi-grid,
      .status-grid,
      .quick-grid {
        grid-template-columns: 1fr;
      }

      .admin-header h1 {
        font-size: 30px;
      }

    }

  </style>

</BaseLayout>