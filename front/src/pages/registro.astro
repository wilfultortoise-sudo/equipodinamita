---
import BaseLayout from '../layouts/BaseLayout.astro';
const pageTitle = "Crear Cuenta — BiblioTech Store";
---

<BaseLayout pageTitle={pageTitle}>
  <div class="auth-page">
    <div class="container auth-container">
      <div class="card auth-card">
        <div class="auth-header">
          <div class="auth-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7.5" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line></svg>
          </div>
          <h2>Crear Cuenta Nueva</h2>
          <p class="auth-subtitle">Regístrate para comprar libros con envío y seguimiento en tiempo real</p>
        </div>

        <div id="reg-error-alert" class="alert-error" style="display: none;"></div>
        <div id="reg-success-alert" class="alert-success" style="display: none;"></div>

        <form id="registro-form" class="auth-form">
          <div class="form-group">
            <label class="form-label" for="nombre">Nombre Completo *</label>
            <input 
              type="text" 
              id="nombre" 
              name="nombre" 
              class="form-input" 
              placeholder="Ej. Alan Omar Yáñez" 
              required 
            />
          </div>

          <div class="form-group">
            <label class="form-label" for="email">Correo Electrónico *</label>
            <input 
              type="email" 
              id="email" 
              name="email" 
              class="form-input" 
              placeholder="ejemplo@ceti.mx" 
              required 
              autocomplete="email"
            />
          </div>

          <div class="form-row">
            <div class="form-group form-col">
              <label class="form-label" for="password">Contraseña *</label>
              <input 
                type="password" 
                id="password" 
                name="password" 
                class="form-input" 
                placeholder="Mínimo 6 caracteres" 
                required 
                autocomplete="new-password"
              />
            </div>
            <div class="form-group form-col">
              <label class="form-label" for="confirmPassword">Confirmar Contraseña *</label>
              <input 
                type="password" 
                id="confirmPassword" 
                name="confirmPassword" 
                class="form-input" 
                placeholder="Repite la contraseña" 
                required 
                autocomplete="new-password"
              />
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="telefono">Teléfono (Opcional)</label>
            <input 
              type="tel" 
              id="telefono" 
              name="telefono" 
              class="form-input" 
              placeholder="Ej. 3312345678" 
            />
          </div>

          <div class="form-group">
            <label class="form-label" for="direccion">Dirección de Entrega (Opcional)</label>
            <textarea 
              id="direccion" 
              name="direccion" 
              class="form-textarea" 
              rows="2" 
              placeholder="Calle, número, colonia, código postal y ciudad..."
            ></textarea>
          </div>

          <button type="submit" id="reg-submit-btn" class="btn btn-primary btn-block">
            <span>Registrarme y Comenzar</span>
          </button>
        </form>

        <div class="auth-footer">
          <p>¿Ya tienes una cuenta registrada? <a href="/login" class="auth-link">Inicia sesión aquí</a></p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .auth-page {
    padding: var(--spacing-xl) 0;
    min-height: calc(85vh - 4rem);
    display: flex;
    align-items: center;
  }

  .auth-container {
    max-width: 520px;
  }

  .auth-card {
    padding: var(--spacing-xl);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
  }

  .auth-header {
    text-align: center;
    margin-bottom: var(--spacing-lg);
  }

  .auth-icon {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .auth-header h2 {
    margin: 0;
    color: var(--color-text);
    font-size: 1.5rem;
  }

  .auth-subtitle {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-top: 0.35rem;
    margin-bottom: 0;
  }

  .alert-error {
    background-color: #fee2e2;
    border: 1px solid #f87171;
    color: #991b1b;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    font-size: 0.88rem;
    margin-bottom: var(--spacing-md);
  }

  .alert-success {
    background-color: #d1fae5;
    border: 1px solid #34d399;
    color: #065f46;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    font-size: 0.88rem;
    margin-bottom: var(--spacing-md);
  }

  .form-row {
    display: flex;
    gap: var(--spacing-md);
  }

  .form-col {
    flex: 1;
  }

  .auth-footer {
    text-align: center;
    margin-top: var(--spacing-lg);
    padding-top: var(--spacing-md);
    border-top: 1px solid var(--color-border);
    font-size: 0.88rem;
    color: var(--color-text-muted);
  }

  .auth-link {
    color: var(--color-primary);
    font-weight: 600;
  }

  .auth-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .form-row {
      flex-direction: column;
      gap: 0;
    }
  }
</style>

<script>
  import { authService } from '../services/auth.js';

  if (authService.isAuthenticated()) {
    window.location.href = '/';
  }

  const form = document.getElementById('registro-form') as HTMLFormElement;
  const submitBtn = document.getElementById('reg-submit-btn') as HTMLButtonElement;
  const errorAlert = document.getElementById('reg-error-alert') as HTMLDivElement;
  const successAlert = document.getElementById('reg-success-alert') as HTMLDivElement;

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorAlert.style.display = 'none';
      successAlert.style.display = 'none';

      const nombre = (document.getElementById('nombre') as HTMLInputElement).value.trim();
      const email = (document.getElementById('email') as HTMLInputElement).value.trim();
      const password = (document.getElementById('password') as HTMLInputElement).value;
      const confirmPassword = (document.getElementById('confirmPassword') as HTMLInputElement).value;
      const telefono = (document.getElementById('telefono') as HTMLInputElement).value.trim();
      const direccion = (document.getElementById('direccion') as HTMLTextAreaElement).value.trim();

      if (!nombre || !email || !password) {
        errorAlert.textContent = 'Por favor completa los campos obligatorios (*).';
        errorAlert.style.display = 'block';
        return;
      }

      if (password.length < 6) {
        errorAlert.textContent = 'La contraseña debe contener al menos 6 caracteres.';
        errorAlert.style.display = 'block';
        return;
      }

      if (password !== confirmPassword) {
        errorAlert.textContent = 'Las contraseñas no coinciden. Verifícalas.';
        errorAlert.style.display = 'block';
        return;
      }

      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span>Creando cuenta...</span>';

      try {
        const res = await authService.registro({
          nombre,
          email,
          password,
          telefono,
          direccion
        });

        successAlert.textContent = `¡Cuenta creada exitosamente! Bienvenido, ${res.usuario.nombre}.`;
        successAlert.style.display = 'block';

        if ((window as any).showToast) {
          (window as any).showToast('¡Registro exitoso! Iniciando sesión...', 'success');
        }

        setTimeout(() => {
          window.location.href = '/catalogo';
        }, 800);
      } catch (err: any) {
        errorAlert.textContent = err.message || 'Error al registrar la cuenta. Intenta de nuevo.';
        errorAlert.style.display = 'block';
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<span>Registrarme y Comenzar</span>';
      }
    });
  }
</script>
