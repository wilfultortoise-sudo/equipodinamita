---
import BaseLayout from '../layouts/BaseLayout.astro';
import PaymentGateway from '../components/islands/PaymentGateway.jsx';
const pageTitle = "Finalizar Compra (Checkout) — BiblioTech Store";
---

<BaseLayout pageTitle={pageTitle}>
  <div class="checkout-page">
    <div class="container">
      
      <!-- Bloque de Protección de Ruta (si no está autenticado) -->
      <div id="auth-required-box" class="card auth-warning-card" style="display: none;">
        <div class="warning-icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
        </div>
        <h2>Se requiere inicio de sesión</h2>
        <p>Para garantizar la seguridad de tu compra, asociar tus pedidos y emitir tu comprobante digital oficial, necesitas acceder a tu cuenta.</p>
        <div class="auth-warning-actions">
          <a href="/login?redirect=/checkout" class="btn btn-primary">Iniciar Sesión</a>
          <a href="/registro?redirect=/checkout" class="btn btn-outline">Crear una Cuenta</a>
        </div>
      </div>

      <!-- Formulario de Checkout Principal -->
      <div id="checkout-main-view" class="checkout-layout" style="display: none;">
        
        <div class="checkout-form-col">
          <div class="checkout-hero">
            <h1>Finalizar Compra (Checkout)</h1>
            <p>Completa tus datos de entrega y selecciona tu método de pago preferido con protección total al comprador.</p>
          </div>

          <div id="checkout-error-alert" class="alert-error" style="display: none;"></div>

          <form id="checkout-form" class="checkout-form">
            
            <!-- Sección 1: Datos de Contacto y Envío -->
            <div class="card form-section-card">
              <div class="section-title-row">
                <span class="step-num">1</span>
                <div>
                  <h3>Dirección de Envío y Contacto</h3>
                  <p class="section-desc">Ingresa dónde deseas recibir tus libros y tus datos de contacto para avisos de entrega.</p>
                </div>
              </div>

              <div class="form-row">
                <div class="form-group form-col">
                  <label class="form-label" for="nombreCliente">Nombre Completo *</label>
                  <input type="text" id="nombreCliente" class="form-input" required placeholder="Ej. Juan Pérez González" />
                </div>
                <div class="form-group form-col">
                  <label class="form-label" for="emailCliente">Correo Electrónico *</label>
                  <input type="email" id="emailCliente" class="form-input" required placeholder="tu.correo@ejemplo.com" />
                </div>
              </div>

              <div class="form-row">
                <div class="form-group form-col">
                  <label class="form-label" for="telefonoCliente">Teléfono de Contacto (10 dígitos) *</label>
                  <input type="tel" id="telefonoCliente" class="form-input" required placeholder="Ej. 3312345678" maxlength="10" />
                </div>
                <div class="form-group form-col">
                  <label class="form-label" for="ciudadCliente">Ciudad / Estado *</label>
                  <input type="text" id="ciudadCliente" class="form-input" value="Guadalajara, Jalisco" required />
                </div>
              </div>

              <div class="form-group">
                <label class="form-label" for="direccionEnvio">Dirección Completa de Entrega (Calle, Número Ext/Int, Colonia, C.P.) *</label>
                <textarea id="direccionEnvio" class="form-textarea" rows="2" required placeholder="Ej. Av. del Parque 1234, Int 4B, Col. Bosques, C.P. 44100"></textarea>
              </div>
            </div>

            <!-- Sección 2: Pasarela Multimétodo Interactiva (Hugo - PaymentGateway Island) -->
            <div class="card form-section-card" style="padding: 0; background: transparent; border: none; box-shadow: none;">
              <PaymentGateway client:load />
            </div>

            <!-- Botón de Envío -->
            <button type="submit" id="submit-order-btn" class="btn btn-primary btn-block btn-lg">
              <span id="submit-btn-label">Pagar con Tarjeta (Mercado Pago API)</span>
            </button>
          </form>
        </div>

        <!-- Columna Resumen de la Orden -->
        <aside class="checkout-summary-col">
          <div class="card checkout-summary-card">
            <h3>Resumen de la Orden</h3>

            <!-- Lista de Libros en Carrito -->
            <div class="order-items-preview-list" id="chk-items-preview">
              <!-- Renderizado dinámicamente -->
            </div>

            <div class="summary-breakdown">
              <div class="breakdown-row">
                <span class="row-label">Subtotal de Libros:</span>
                <span class="row-val" id="chk-subtotal">$0.00 MXN</span>
              </div>
              <div class="breakdown-row" id="chk-discount-row" style="display: none;">
                <span class="row-label">Descuento aplicado:</span>
                <span class="row-val-discount" id="chk-discount">-$0.00 MXN</span>
              </div>
              <div class="breakdown-row">
                <span class="row-label">Costo de Envío:</span>
                <span class="row-val" id="chk-shipping">$99.00 MXN</span>
              </div>
              <div class="breakdown-sep"></div>
              <div class="breakdown-row total-row">
                <span class="row-label"><strong>Total a Pagar:</strong></span>
                <span class="row-val" id="chk-total" style="color: var(--color-primary); font-size: 1.25rem;">$0.00 MXN</span>
              </div>
            </div>

            <div class="shipping-badge-box">
              <span>🚚 <strong>Envío estándar:</strong> Entrega estimada de 2 a 4 días hábiles. Envío GRATIS en compras mayores a $999.</span>
            </div>

            <div class="security-guarantee-box">
              <div class="guarantee-item">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                <span>Garantía de Entrega y Devolución</span>
              </div>
              <div class="guarantee-item">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                <span>Transacción 100% Cifrada SSL (256 bits)</span>
              </div>
            </div>

            <div class="back-cart-link">
              <a href="/carrito">← Modificar carrito de compras</a>
            </div>
          </div>
        </aside>

      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .checkout-page {
    padding-block: var(--spacing-xl);
    background: var(--color-background);
    min-height: 80vh;
  }

  .auth-warning-card {
    max-width: 550px;
    margin: 2rem auto;
    text-align: center;
    padding: var(--spacing-xl);
  }

  .warning-icon {
    color: var(--color-primary);
    margin-bottom: var(--spacing-md);
  }

  .auth-warning-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: var(--spacing-lg);
  }

  .checkout-layout {
    display: grid;
    grid-template-columns: 1fr 390px;
    gap: var(--spacing-xl);
    align-items: start;
  }

  @media (max-width: 992px) {
    .checkout-layout {
      grid-template-columns: 1fr;
    }
  }

  .checkout-hero {
    margin-bottom: var(--spacing-lg);
  }

  .checkout-hero h1 {
    font-size: 1.85rem;
    margin-bottom: 0.35rem;
  }

  .checkout-hero p {
    color: var(--color-text-muted);
    margin: 0;
  }

  .form-section-card {
    padding: var(--spacing-lg);
    background: var(--color-surface);
    margin-bottom: var(--spacing-lg);
    border-radius: var(--radius-lg);
  }

  .section-title-row {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    margin-bottom: var(--spacing-lg);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--spacing-sm);
  }

  .step-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: var(--color-primary);
    color: white;
    border-radius: 50%;
    font-weight: 700;
    font-size: 0.95rem;
    flex-shrink: 0;
  }

  .section-title-row h3 {
    margin: 0 0 0.2rem 0;
    font-size: 1.15rem;
  }

  .section-desc {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .form-row {
    display: flex;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-md);
  }

  .form-col {
    flex: 1;
    margin-bottom: 0 !important;
  }

  @media (max-width: 600px) {
    .form-row {
      flex-direction: column;
    }
  }

  .form-group {
    margin-bottom: var(--spacing-md);
  }

  .form-label {
    display: block;
    margin-bottom: 0.4rem;
    font-size: 0.88rem;
    font-weight: 600;
  }

  .form-input, .form-textarea {
    width: 100%;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: 0.95rem;
    box-sizing: border-box;
    font-family: inherit;
  }

  .form-input:focus, .form-textarea:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
  }

  .btn-block {
    width: 100%;
  }

  .btn-lg {
    padding: 0.85rem 1.5rem;
    font-size: 1.1rem;
    font-weight: 700;
  }

  /* Resumen Columna */
  .checkout-summary-card {
    position: sticky;
    top: 2rem;
    padding: var(--spacing-lg);
  }

  .checkout-summary-card h3 {
    margin-top: 0;
    margin-bottom: var(--spacing-md);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.5rem;
  }

  .order-items-preview-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-height: 280px;
    overflow-y: auto;
    margin-bottom: var(--spacing-md);
    padding-right: 0.25rem;
  }

  :global(.order-item-mini) {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    font-size: 0.88rem;
  }

  :global(.mini-thumb) {
    width: 44px;
    height: 60px;
    object-fit: cover;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  :global(.mini-details) {
    flex: 1;
    overflow: hidden;
  }

  :global(.mini-title) {
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-weight: 600;
  }

  :global(.mini-meta) {
    display: block;
    color: var(--color-text-muted);
    font-size: 0.8rem;
  }

  :global(.mini-price) {
    font-weight: 600;
    white-space: nowrap;
  }

  .summary-breakdown {
    border-top: 1px solid var(--color-border);
    padding-top: var(--spacing-md);
    margin-bottom: var(--spacing-md);
  }

  .breakdown-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.5rem;
    font-size: 0.9rem;
  }

  .row-val-discount {
    color: #16a34a;
    font-weight: 600;
  }

  .breakdown-sep {
    height: 1px;
    background: var(--color-border);
    margin-block: 0.5rem;
  }

  .total-row {
    font-size: 1.15rem;
  }

  .shipping-badge-box {
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    color: #166534;
    padding: 0.75rem;
    border-radius: var(--radius-md);
    font-size: 0.82rem;
    margin-bottom: var(--spacing-md);
    line-height: 1.4;
  }

  .security-guarantee-box {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border-top: 1px solid var(--color-border);
    padding-top: var(--spacing-md);
  }

  .guarantee-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .guarantee-item svg {
    color: #10b981;
    flex-shrink: 0;
  }

  .back-cart-link {
    text-align: center;
    margin-top: var(--spacing-md);
    font-size: 0.85rem;
  }

  .back-cart-link a {
    color: var(--color-primary);
  }

  .alert-error {
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #b91c1c;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    margin-bottom: var(--spacing-md);
    font-size: 0.9rem;
  }
</style>

<script>
  import { authService } from '../services/auth.js';
  import { cartService } from '../services/cart.js';
  import { apiClient } from '../services/apiClient.js';

  const authBox = document.getElementById('auth-required-box') as HTMLElement;
  const mainView = document.getElementById('checkout-main-view') as HTMLElement;
  const form = document.getElementById('checkout-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-order-btn') as HTMLButtonElement;
  const submitBtnLabel = document.getElementById('submit-btn-label') as HTMLElement;
  const errorAlert = document.getElementById('checkout-error-alert') as HTMLDivElement;

  const itemsPreview = document.getElementById('chk-items-preview') as HTMLElement;
  const subtotalEl = document.getElementById('chk-subtotal') as HTMLElement;
  const discountRow = document.getElementById('chk-discount-row') as HTMLElement;
  const discountEl = document.getElementById('chk-discount') as HTMLElement;
  const shippingEl = document.getElementById('chk-shipping') as HTMLElement;
  const totalEl = document.getElementById('chk-total') as HTMLElement;

  // 1. Verificación de Autenticación
  if (!authService.isAuthenticated()) {
    if (authBox) authBox.style.display = 'block';
    if (mainView) mainView.style.display = 'none';
  } else {
    if (authBox) authBox.style.display = 'none';
    if (mainView) mainView.style.display = 'grid';

    // 2. Verificar Items en Carrito
    const cartItems = cartService.getItems();
    if (cartItems.length === 0) {
      if ((window as any).showToast) (window as any).showToast('Tu carrito está vacío. Agrega libros primero.', 'info');
      setTimeout(() => {
        window.location.href = '/catalogo';
      }, 400);
    }

    // 3. Prellenar datos del usuario
    const user = authService.getUser();
    if (user) {
      const nombreInput = document.getElementById('nombreCliente') as HTMLInputElement;
      const emailInput = document.getElementById('emailCliente') as HTMLInputElement;
      const telInput = document.getElementById('telefonoCliente') as HTMLInputElement;
      const dirInput = document.getElementById('direccionEnvio') as HTMLTextAreaElement;

      if (nombreInput) nombreInput.value = user.nombre || '';
      if (emailInput) emailInput.value = user.email || '';
      if (telInput && user.telefono) telInput.value = user.telefono;
      if (dirInput && user.direccion) dirInput.value = user.direccion;
    }

    // 4. Renderizar desglose financiero de la orden
    if (itemsPreview) {
      itemsPreview.innerHTML = cartItems.map((item: any) => `
        <div class="order-item-mini">
          <img src="${item.imagen || 'https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?w=100'}" alt="${item.titulo}" class="mini-thumb" />
          <div class="mini-details">
            <span class="mini-title">${item.titulo}</span>
            <span class="mini-meta">Cant: ${item.cantidad} × $${Number(item.precio).toFixed(2)}</span>
          </div>
          <span class="mini-price">$${(Number(item.precio) * Number(item.cantidad)).toFixed(2)}</span>
        </div>
      `).join('');
    }

    const fin = cartService.getFinancials();
    if (subtotalEl) subtotalEl.textContent = `$${fin.subtotal.toFixed(2)} MXN`;
    if (shippingEl) shippingEl.textContent = fin.shipping === 0 ? 'GRATIS' : `$${fin.shipping.toFixed(2)} MXN`;
    if (totalEl) totalEl.textContent = `$${fin.total.toFixed(2)} MXN`;

    if (fin.discount > 0 && discountRow) {
      discountRow.style.display = 'flex';
      if (discountEl) discountEl.textContent = `-$${fin.discount.toFixed(2)} MXN`;
    }

    // 5. Comunicación reactiva con la Pasarela Multimétodo (Hugo - PaymentGateway.jsx)
    let currentPaymentInfo: {
      metodoPago: string;
      detallesPago: string | null;
      referenciaPago: string | null;
      isCardValid?: boolean;
      cardError?: string | null;
    } = {
      metodoPago: 'MERCADO_PAGO',
      detallesPago: null,
      referenciaPago: null,
      isCardValid: true
    };

    window.addEventListener('payment-method-changed', (e: any) => {
      if (e.detail) {
        currentPaymentInfo = {
          metodoPago: e.detail.metodoPago || 'TARJETA_CREDITO',
          detallesPago: e.detail.detallesPago || null,
          referenciaPago: e.detail.referenciaPago || null,
          isCardValid: e.detail.isCardValid !== undefined ? e.detail.isCardValid : true,
          cardError: e.detail.cardError || null
        };

        if (submitBtnLabel) {
          if (currentPaymentInfo.metodoPago === 'OXXO_EFECTIVO') {
            submitBtnLabel.textContent = 'Generar Ficha OXXO Pay';
          } else if (currentPaymentInfo.metodoPago === 'TRANSFERENCIA_SPEI') {
            submitBtnLabel.textContent = 'Confirmar Orden con SPEI';
          } else if (currentPaymentInfo.metodoPago === 'PAYPAL') {
            submitBtnLabel.textContent = 'Pagar con PayPal';
          } else if (currentPaymentInfo.metodoPago === 'MERCADO_PAGO') {
            submitBtnLabel.textContent = 'Pagar con Mercado Pago (Card Token)';
          } else {
            submitBtnLabel.textContent = 'Pagar con Tarjeta Bancaria';
          }
        }
      }
    });

    // 6. Enviar la orden de compra con GraphQL
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (errorAlert) errorAlert.style.display = 'none';

        // Validar existencias
        const overStock = cartItems.find((i: any) => Number(i.cantidad) > Number(i.stock));
        if (overStock) {
          const msg = `Stock insuficiente para "${overStock.titulo}". Solicitado: ${overStock.cantidad}, disponible: ${overStock.stock}.`;
          if (errorAlert) {
            errorAlert.textContent = msg;
            errorAlert.style.display = 'block';
          }
          if ((window as any).showToast) (window as any).showToast(msg, 'error');
          return;
        }

        // Validar datos de contacto y entrega
        const nombreCliente = (document.getElementById('nombreCliente') as HTMLInputElement).value.trim();
        const emailCliente = (document.getElementById('emailCliente') as HTMLInputElement).value.trim();
        const telefonoClienteInput = document.getElementById('telefonoCliente') as HTMLInputElement;
        const telefonoCliente = telefonoClienteInput ? telefonoClienteInput.value.trim() : '';
        const direccionEnvio = (document.getElementById('direccionEnvio') as HTMLTextAreaElement).value.trim();
        const ciudad = (document.getElementById('ciudadCliente') as HTMLInputElement).value.trim();

        if (!nombreCliente || !emailCliente || !direccionEnvio) {
          const msg = 'Por favor completa todos los campos requeridos de envío y contacto.';
          if (errorAlert) {
            errorAlert.textContent = msg;
            errorAlert.style.display = 'block';
          }
          return;
        }

        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(emailCliente)) {
          const msg = 'El correo electrónico ingresado no tiene un formato válido.';
          if (errorAlert) {
            errorAlert.textContent = msg;
            errorAlert.style.display = 'block';
          }
          return;
        }

        if (telefonoCliente && !/^\d{10}$/.test(telefonoCliente)) {
          const msg = 'El teléfono de contacto debe tener exactamente 10 dígitos numéricos.';
          if (errorAlert) {
            errorAlert.textContent = msg;
            errorAlert.style.display = 'block';
          }
          if (telefonoClienteInput) telefonoClienteInput.focus();
          return;
        }

        // Si el método es tarjeta bancaria o pasarela Mercado Pago, validar que los datos sean correctos (incluyendo Amex 15 dígitos y CID)
        if (
          currentPaymentInfo.metodoPago === 'TARJETA_CREDITO' ||
          currentPaymentInfo.metodoPago === 'TARJETA_DEBITO' ||
          currentPaymentInfo.metodoPago === 'MERCADO_PAGO'
        ) {
          if (currentPaymentInfo.isCardValid === false) {
            const msg = currentPaymentInfo.cardError || 'Por favor completa los datos de la tarjeta correctamente.';
            if (errorAlert) {
              errorAlert.textContent = msg;
              errorAlert.style.display = 'block';
            }
            window.scrollTo({ top: 300, behavior: 'smooth' });
            return;
          }
        }

        const fullAddress = `${direccionEnvio}, ${ciudad}`;
        const items = cartItems.map((i: any) => ({
          productoId: i.id,
          cantidad: i.cantidad
        }));

        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span>⏳ Procesando pago seguro y emitiendo folio...</span>';

        const mutation = `
          mutation CrearPedidoDirecto($datos: PedidoInput!) {
            crearPedido(datos: $datos) {
              id
              folio
              fecha
              subtotal
              envio
              total
              status
              metodoPago
              nombreCliente
              detallesPago
              referenciaPago
            }
          }
        `;

        try {
          const res = await apiClient.mutation(mutation, {
            datos: {
              items,
              metodoPago: currentPaymentInfo.metodoPago,
              direccionEnvio: fullAddress,
              nombreCliente,
              emailCliente,
              usuarioId: user ? user.id : null,
              detallesPago: currentPaymentInfo.detallesPago,
              referenciaPago: currentPaymentInfo.referenciaPago
            }
          });

          if (res?.crearPedido?.folio) {
            sessionStorage.setItem('last_order_details', JSON.stringify({
              ...res.crearPedido,
              detalles: cartItems,
              emailCliente,
              direccionEnvio: fullAddress
            }));

            cartService.clearCart();
            if ((window as any).showToast) {
              (window as any).showToast('¡Pago aprobado y orden confirmada exitosamente!', 'success');
            }
            setTimeout(() => {
              const urlParams = new URLSearchParams({
                folio: res.crearPedido.folio,
                metodo: res.crearPedido.metodoPago || currentPaymentInfo.metodoPago,
                ref: res.crearPedido.referenciaPago || ''
              });
              window.location.href = `/orden-confirmada?${urlParams.toString()}`;
            }, 400);
          } else {
            throw new Error('No se recibió el folio oficial de confirmación del servidor.');
          }
        } catch (err: any) {
          const errMsg = err.message || 'Error al procesar el pago. Por favor intenta nuevamente.';
          if (errorAlert) {
            errorAlert.textContent = errMsg;
            errorAlert.style.display = 'block';
            errorAlert.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
          if ((window as any).showToast) {
            (window as any).showToast(errMsg, 'error');
          }
          submitBtn.disabled = false;
          submitBtn.innerHTML = '<span id="submit-btn-label">Confirmar y Pagar Orden</span>';
        }
      });
    }
  }
</script>
