---
import BaseLayout from '../layouts/BaseLayout.astro';
const pageTitle = "Finalizar Compra (Checkout) — BiblioTech Store";
---

<BaseLayout pageTitle={pageTitle}>
  <div class="checkout-page">
    <div class="container">
      
      <!-- Bloque de Protección de Ruta (si no está autenticado) -->
      <div id="auth-required-box" class="card auth-warning-card" style="display: none;">
        <div class="warning-icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
        </div>
        <h2>Se requiere inicio de sesión</h2>
        <p>Para garantizar la seguridad de tu compra, asociar tus pedidos y emitir tu comprobante digital oficial, necesitas acceder a tu cuenta.</p>
        <div class="auth-warning-actions">
          <a href="/login?redirect=/checkout" class="btn btn-primary">Iniciar Sesión</a>
          <a href="/registro?redirect=/checkout" class="btn btn-outline">Crear una Cuenta</a>
        </div>
      </div>

      <!-- Formulario de Checkout Principal -->
      <div id="checkout-main-view" class="checkout-layout" style="display: none;">
        
        <div class="checkout-form-col">
          <div class="checkout-hero">
            <h1>Finalizar Compra (Checkout)</h1>
            <p>Completa tus datos de entrega y selecciona tu método de pago preferido con protección al comprador.</p>
          </div>

          <div id="checkout-error-alert" class="alert-error" style="display: none;"></div>

          <form id="checkout-form" class="checkout-form">
            
            <!-- Sección 1: Datos de Contacto y Envío -->
            <div class="card form-section-card">
              <div class="section-title-row">
                <span class="step-num">1</span>
                <div>
                  <h3>Dirección de Envío y Contacto</h3>
                  <p class="section-desc">Ingresa dónde deseas recibir tus libros y tus datos de contacto para avisos de entrega.</p>
                </div>
              </div>

              <div class="form-row">
                <div class="form-group form-col">
                  <label class="form-label" for="nombreCliente">Nombre Completo *</label>
                  <input type="text" id="nombreCliente" class="form-input" required placeholder="Ej. Juan Pérez González" />
                </div>
                <div class="form-group form-col">
                  <label class="form-label" for="emailCliente">Correo Electrónico *</label>
                  <input type="email" id="emailCliente" class="form-input" required placeholder="tu.correo@ejemplo.com" />
                </div>
              </div>

              <div class="form-row">
                <div class="form-group form-col">
                  <label class="form-label" for="telefonoCliente">Teléfono de Contacto (10 dígitos) *</label>
                  <input type="tel" id="telefonoCliente" class="form-input" required placeholder="Ej. 3312345678" maxlength="10" />
                </div>
                <div class="form-group form-col">
                  <label class="form-label" for="ciudadCliente">Ciudad / Estado *</label>
                  <input type="text" id="ciudadCliente" class="form-input" value="Guadalajara, Jalisco" required />
                </div>
              </div>

              <div class="form-group">
                <label class="form-label" for="direccionEnvio">Dirección Completa de Entrega (Calle, Número Ext/Int, Colonia, C.P.) *</label>
                <textarea id="direccionEnvio" class="form-textarea" rows="2" required placeholder="Ej. Av. del Parque 1234, Int 4B, Col. Bosques, C.P. 44100"></textarea>
              </div>
            </div>

            <!-- Sección 2: Pasarela Multimétodo Interactiva (Bloque A - Hugo & Validación) -->
            <div class="card form-section-card">
              <div class="section-title-row">
                <span class="step-num">2</span>
                <div>
                  <h3>Pasarela Multimétodo de Pago Seguro</h3>
                  <p class="section-desc">Selecciona tu método de pago preferido. Todas las transacciones cuentan con cifrado SSL de 256 bits.</p>
                </div>
              </div>

              <!-- Selector de Métodos de Pago -->
              <div class="payment-methods-grid">
                <label class="payment-card-option selected" data-method="TARJETA_CREDITO">
                  <input type="radio" name="metodoPago" value="TARJETA_CREDITO" checked />
                  <div class="payment-content">
                    <span class="payment-icon">💳</span>
                    <span class="payment-name">Tarjeta Crédito</span>
                    <span class="payment-sub">Hasta 6 MSI</span>
                  </div>
                </label>

                <label class="payment-card-option" data-method="TARJETA_DEBITO">
                  <input type="radio" name="metodoPago" value="TARJETA_DEBITO" />
                  <div class="payment-content">
                    <span class="payment-icon">🏧</span>
                    <span class="payment-name">Tarjeta Débito</span>
                    <span class="payment-sub">Pago inmediato</span>
                  </div>
                </label>

                <label class="payment-card-option" data-method="OXXO_EFECTIVO">
                  <input type="radio" name="metodoPago" value="OXXO_EFECTIVO" />
                  <div class="payment-content">
                    <span class="payment-icon">🏪</span>
                    <span class="payment-name">OXXO Pay</span>
                    <span class="payment-sub">Pago en efectivo</span>
                  </div>
                </label>

                <label class="payment-card-option" data-method="MERCADO_PAGO">
                  <input type="radio" name="metodoPago" value="MERCADO_PAGO" />
                  <div class="payment-content">
                    <span class="payment-icon">🤝</span>
                    <span class="payment-name">Mercado Pago</span>
                    <span class="payment-sub">QR / Saldo MP</span>
                  </div>
                </label>

                <label class="payment-card-option" data-method="PAYPAL">
                  <input type="radio" name="metodoPago" value="PAYPAL" />
                  <div class="payment-content">
                    <span class="payment-icon">🅿️</span>
                    <span class="payment-name">PayPal</span>
                    <span class="payment-sub">Protección total</span>
                  </div>
                </label>

                <label class="payment-card-option" data-method="TRANSFERENCIA_SPEI">
                  <input type="radio" name="metodoPago" value="TRANSFERENCIA_SPEI" />
                  <div class="payment-content">
                    <span class="payment-icon">🏦</span>
                    <span class="payment-name">SPEI (Transfer)</span>
                    <span class="payment-sub">CLABE 24/7</span>
                  </div>
                </label>
              </div>

              <!-- PANEL 1: Tarjeta Crédito / Débito Interactiva -->
              <div id="panel-card" class="payment-details-panel">
                <div class="card-interactive-preview">
                  <div class="virtual-card">
                    <div class="virtual-card-top">
                      <span class="card-chip"></span>
                      <span class="card-brand" id="preview-card-brand">VISA / MASTERCARD</span>
                    </div>
                    <div class="virtual-card-number" id="preview-card-number">4152 •••• •••• 9812</div>
                    <div class="virtual-card-bottom">
                      <div>
                        <span class="card-label-small">TITULAR</span>
                        <span class="card-holder-name" id="preview-card-holder">NOMBRE DEL CLIENTE</span>
                      </div>
                      <div>
                        <span class="card-label-small">EXP</span>
                        <span class="card-exp-date" id="preview-card-exp">12/28</span>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="card-inputs-grid">
                  <div class="form-group">
                    <label class="form-label" for="card-num-input">Número de Tarjeta *</label>
                    <input type="text" id="card-num-input" class="form-input" placeholder="4152 7890 1234 9812" maxlength="19" value="4152 7890 1234 9812" />
                  </div>
                  <div class="form-group">
                    <label class="form-label" for="card-holder-input">Nombre en la Tarjeta *</label>
                    <input type="text" id="card-holder-input" class="form-input" placeholder="JUAN PEREZ GONZALEZ" />
                  </div>
                  <div class="form-row">
                    <div class="form-group form-col">
                      <label class="form-label" for="card-exp-input">Vencimiento (MM/AA) *</label>
                      <input type="text" id="card-exp-input" class="form-input" placeholder="12/28" maxlength="5" value="12/28" />
                    </div>
                    <div class="form-group form-col">
                      <label class="form-label" for="card-cvv-input">CVV (3-4 dígitos) *</label>
                      <input type="password" id="card-cvv-input" class="form-input" placeholder="789" maxlength="4" value="789" />
                    </div>
                  </div>
                  <div class="form-group" id="installments-group">
                    <label class="form-label" for="card-installments">Plan de Pagos</label>
                    <select id="card-installments" class="form-select">
                      <option value="1">1 solo pago de contado</option>
                      <option value="3">3 Meses Sin Intereses (MSI)</option>
                      <option value="6">6 Meses Sin Intereses (MSI)</option>
                    </select>
                  </div>
                </div>
              </div>

              <!-- PANEL 2: OXXO Pay Interactivo -->
              <div id="panel-oxxo" class="payment-details-panel" style="display: none;">
                <div class="voucher-box oxxo-voucher">
                  <div class="voucher-header">
                    <div class="oxxo-logo-badge">OXXO Pay</div>
                    <span class="voucher-expiry">⏰ Vence en 48 horas</span>
                  </div>
                  <div class="voucher-body">
                    <span class="ref-label">Número de Referencia Digital para Pago:</span>
                    <div class="ref-code" id="oxxo-ref-code">9384 1029 4820 11</div>
                    
                    <!-- Simulación de Código de Barras SVG -->
                    <div class="barcode-container">
                      <svg width="220" height="45" viewBox="0 0 220 45">
                        <rect x="0" y="0" width="3" height="45" fill="#000"/>
                        <rect x="6" y="0" width="2" height="45" fill="#000"/>
                        <rect x="11" y="0" width="4" height="45" fill="#000"/>
                        <rect x="18" y="0" width="2" height="45" fill="#000"/>
                        <rect x="23" y="0" width="5" height="45" fill="#000"/>
                        <rect x="31" y="0" width="2" height="45" fill="#000"/>
                        <rect x="36" y="0" width="3" height="45" fill="#000"/>
                        <rect x="42" y="0" width="4" height="45" fill="#000"/>
                        <rect x="49" y="0" width="2" height="45" fill="#000"/>
                        <rect x="54" y="0" width="5" height="45" fill="#000"/>
                        <rect x="62" y="0" width="3" height="45" fill="#000"/>
                        <rect x="68" y="0" width="2" height="45" fill="#000"/>
                        <rect x="73" y="0" width="4" height="45" fill="#000"/>
                        <rect x="80" y="0" width="2" height="45" fill="#000"/>
                        <rect x="85" y="0" width="6" height="45" fill="#000"/>
                        <rect x="94" y="0" width="3" height="45" fill="#000"/>
                        <rect x="100" y="0" width="2" height="45" fill="#000"/>
                        <rect x="105" y="0" width="5" height="45" fill="#000"/>
                        <rect x="113" y="0" width="3" height="45" fill="#000"/>
                        <rect x="119" y="0" width="4" height="45" fill="#000"/>
                        <rect x="126" y="0" width="2" height="45" fill="#000"/>
                        <rect x="131" y="0" width="5" height="45" fill="#000"/>
                        <rect x="139" y="0" width="3" height="45" fill="#000"/>
                        <rect x="145" y="0" width="2" height="45" fill="#000"/>
                        <rect x="150" y="0" width="4" height="45" fill="#000"/>
                        <rect x="157" y="0" width="3" height="45" fill="#000"/>
                        <rect x="163" y="0" width="5" height="45" fill="#000"/>
                        <rect x="171" y="0" width="2" height="45" fill="#000"/>
                        <rect x="176" y="0" width="4" height="45" fill="#000"/>
                        <rect x="183" y="0" width="2" height="45" fill="#000"/>
                        <rect x="188" y="0" width="5" height="45" fill="#000"/>
                        <rect x="196" y="0" width="3" height="45" fill="#000"/>
                        <rect x="202" y="0" width="4" height="45" fill="#000"/>
                        <rect x="209" y="0" width="2" height="45" fill="#000"/>
                        <rect x="214" y="0" width="6" height="45" fill="#000"/>
                      </svg>
                    </div>
                  </div>
                  <div class="voucher-steps">
                    <strong>Instrucciones de pago en tienda:</strong>
                    <ol>
                      <li>Acude a cualquier tienda OXXO de la República Mexicana.</li>
                      <li>Indica al cajero que realizarás un pago de servicio <strong>OXXO Pay</strong>.</li>
                      <li>Dicta el número de referencia o muestra la pantalla de tu comprobante.</li>
                      <li>Conserva tu ticket de compra; tu orden se acreditará automáticamente.</li>
                    </ol>
                  </div>
                </div>
              </div>

              <!-- PANEL 3: Mercado Pago Interactivo -->
              <div id="panel-mercadopago" class="payment-details-panel" style="display: none;">
                <div class="voucher-box mp-voucher">
                  <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:1rem;">
                    <span style="font-size:2rem;">🤝</span>
                    <div>
                      <strong style="font-size:1.1rem;">Paga seguro con Mercado Pago</strong>
                      <p style="margin:0; font-size:0.85rem; color:var(--color-text-muted);">Usa tu dinero en cuenta, tarjetas guardadas o escanea con la app de Mercado Pago.</p>
                    </div>
                  </div>
                  <div class="mp-qr-box">
                    <div class="qr-mockup">
                      <svg width="120" height="120" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect><line x1="7" y1="7" x2="7.01" y2="7"></line><line x1="17" y1="7" x2="17.01" y2="7"></line><line x1="17" y1="17" x2="17.01" y2="17"></line><line x1="7" y1="17" x2="7.01" y2="17"></line></svg>
                    </div>
                    <div>
                      <span class="badge badge-success" style="margin-bottom:0.5rem;">Acreditación Instantánea</span>
                      <p style="margin:0; font-size:0.85rem;">Al confirmar la orden, se validará el cargo de forma segura a través de la pasarela integrada.</p>
                    </div>
                  </div>
                </div>
              </div>

              <!-- PANEL 4: PayPal Interactivo -->
              <div id="panel-paypal" class="payment-details-panel" style="display: none;">
                <div class="voucher-box paypal-voucher">
                  <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:1rem;">
                    <span style="font-size:2rem;">🅿️</span>
                    <div>
                      <strong style="font-size:1.1rem;">Checkout Rápido con PayPal</strong>
                      <p style="margin:0; font-size:0.85rem; color:var(--color-text-muted);">Protección al comprador de PayPal incluida durante 180 días.</p>
                    </div>
                  </div>
                  <p style="font-size:0.88rem; color:var(--color-text-muted); margin:0;">Al hacer clic en Confirmar Orden, procesaremos el pago mediante la cuenta de PayPal vinculada.</p>
                </div>
              </div>

              <!-- PANEL 5: SPEI Transferencia Interbancaria -->
              <div id="panel-spei" class="payment-details-panel" style="display: none;">
                <div class="voucher-box spei-voucher">
                  <h4 style="margin:0 0 0.75rem 0; font-size:1rem;">Datos para Transferencia Electrónica (SPEI 24/7):</h4>
                  <div class="spei-grid">
                    <div class="spei-item">
                      <span class="spei-label">BANCO DESTINO:</span>
                      <strong>STP / BiblioTech Payments</strong>
                    </div>
                    <div class="spei-item">
                      <span class="spei-label">BENEFICIARIO:</span>
                      <strong>BiblioTech Store S.A. de C.V.</strong>
                    </div>
                    <div class="spei-item spei-clabe-row">
                      <div>
                        <span class="spei-label">CLABE INTERBANCARIA:</span>
                        <strong class="spei-clabe" id="spei-clabe-val">6461 8012 3456 7890 12</strong>
                      </div>
                      <button type="button" id="btn-copy-clabe" class="btn btn-outline btn-sm">Copiar CLABE</button>
                    </div>
                    <div class="spei-item">
                      <span class="spei-label">CONCEPTO / REFERENCIA:</span>
                      <strong id="spei-concept-val">BIBLIOTECH-COMPRA</strong>
                    </div>
                  </div>
                  <p style="font-size:0.8rem; color:var(--color-text-muted); margin:0.75rem 0 0 0;">💡 Tu orden se procesa automáticamente sin comisiones adicionales.</p>
                </div>
              </div>

            </div>

            <!-- Botón de Envío -->
            <button type="submit" id="submit-order-btn" class="btn btn-primary btn-block btn-lg">
              <span id="btn-submit-label">Confirmar y Pagar Orden</span>
            </button>
          </form>
        </div>

        <!-- Columna Resumen de la Orden -->
        <aside class="checkout-summary-col">
          <div class="card checkout-summary-card">
            <h3>Resumen del Pedido</h3>
            
            <div id="order-items-preview" class="order-items-preview-list">
              <!-- Renderizado dinámicamente -->
            </div>

            <div class="summary-breakdown">
              <div class="breakdown-row">
                <span class="row-label">Subtotal</span>
                <span id="chk-subtotal" class="row-val">$0.00 MXN</span>
              </div>
              <div id="chk-discount-row" class="breakdown-row discount-row" style="display: none;">
                <span class="row-label">Descuento</span>
                <span id="chk-discount" class="row-val-discount">-$0.00 MXN</span>
              </div>
              <div class="breakdown-row">
                <span class="row-label">Envío</span>
                <span id="chk-shipping" class="row-val">$0.00 MXN</span>
              </div>
              <div class="breakdown-sep"></div>
              <div class="breakdown-row total-row">
                <span class="total-label">Total a Pagar</span>
                <span id="chk-total" class="total-val">$0.00 MXN</span>
              </div>
            </div>

            <div class="security-guarantee-box">
              <div style="display:flex; align-items:center; gap:0.5rem;">
                <span style="color:#059669; font-size:1.2rem;">🔒</span>
                <span style="font-size:0.8rem; color:var(--color-text-muted);">Compra 100% Protegida y Garantizada</span>
              </div>
            </div>

            <div class="back-cart-link">
              <a href="/carrito">← Modificar carrito</a>
            </div>
          </div>
        </aside>

      </div>

    </div>
  </div>
</BaseLayout>

<style>
  .checkout-page {
    padding: var(--spacing-xl) 0 var(--spacing-2xl);
  }

  .auth-warning-card {
    text-align: center;
    max-width: 540px;
    margin: var(--spacing-2xl) auto;
    padding: var(--spacing-2xl) var(--spacing-xl);
    background: var(--color-surface);
  }

  .warning-icon {
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  .auth-warning-card h2 {
    margin: 0 0 0.5rem 0;
  }

  .auth-warning-card p {
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-xl);
  }

  .auth-warning-actions {
    display: flex;
    justify-content: center;
    gap: var(--spacing-md);
  }

  .checkout-layout {
    display: grid;
    grid-template-columns: 1fr 390px;
    gap: var(--spacing-xl);
    align-items: start;
  }

  .checkout-hero {
    margin-bottom: var(--spacing-lg);
  }

  .checkout-hero h1 {
    margin: 0 0 0.25rem 0;
    font-size: 1.85rem;
    font-weight: 800;
  }

  .checkout-hero p {
    margin: 0;
    color: var(--color-text-muted);
  }

  .form-section-card {
    padding: var(--spacing-xl);
    background: var(--color-surface);
    margin-bottom: var(--spacing-lg);
    border-radius: var(--radius-lg);
  }

  .section-title-row {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    margin-bottom: var(--spacing-lg);
    padding-bottom: var(--spacing-sm);
    border-bottom: 1px solid var(--color-border);
  }

  .section-title-row h3 {
    margin: 0;
    font-size: 1.2rem;
  }

  .section-desc {
    margin: 0.15rem 0 0 0;
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }

  .step-num {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--color-primary);
    color: white;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
    flex-shrink: 0;
  }

  .form-row {
    display: flex;
    gap: var(--spacing-md);
  }

  .form-col {
    flex: 1;
  }

  /* Grid de Métodos de Pago (Bloque A) */
  .payment-methods-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-lg);
  }

  .payment-card-option {
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 0.85rem 0.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    cursor: pointer;
    background: var(--color-surface);
    transition: all 0.2s ease;
  }

  .payment-card-option input {
    display: none;
  }

  .payment-card-option:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
  }

  .payment-card-option.selected {
    border-color: var(--color-primary);
    background: #eff6ff;
    box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.2);
  }

  .payment-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
  }

  .payment-icon {
    font-size: 1.6rem;
  }

  .payment-name {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .payment-sub {
    font-size: 0.7rem;
    color: var(--color-text-muted);
  }

  /* Paneles de Métodos */
  .payment-details-panel {
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    margin-top: 0.5rem;
    animation: fadeIn 0.25s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Virtual Card */
  .card-interactive-preview {
    margin-bottom: 1.25rem;
    display: flex;
    justify-content: center;
  }

  .virtual-card {
    width: 100%;
    max-width: 340px;
    height: 190px;
    background: linear-gradient(135deg, #1e293b, #0f172a);
    border-radius: 12px;
    padding: 1.25rem;
    color: white;
    box-shadow: 0 10px 20px rgba(0,0,0,0.25);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    overflow: hidden;
  }

  .virtual-card::after {
    content: '';
    position: absolute;
    top: -50%;
    right: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(255,255,255,0.08) 0%, transparent 60%);
    pointer-events: none;
  }

  .virtual-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .card-chip {
    width: 38px;
    height: 28px;
    background: linear-gradient(135deg, #fbbf24, #d97706);
    border-radius: 4px;
    display: inline-block;
  }

  .card-brand {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: #94a3b8;
  }

  .virtual-card-number {
    font-family: monospace;
    font-size: 1.25rem;
    letter-spacing: 0.1em;
    font-weight: 700;
  }

  .virtual-card-bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .card-label-small {
    display: block;
    font-size: 0.65rem;
    color: #94a3b8;
    text-transform: uppercase;
  }

  .card-holder-name, .card-exp-date {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  /* Vouchers */
  .voucher-box {
    background: var(--color-surface);
    border: 1.5px dashed var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.25rem;
  }

  .oxxo-voucher {
    border-color: #ef4444;
  }

  .voucher-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .oxxo-logo-badge {
    background: #dc2626;
    color: white;
    font-weight: 900;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    letter-spacing: 0.05em;
  }

  .voucher-expiry {
    font-size: 0.8rem;
    color: #d97706;
    font-weight: 600;
  }

  .voucher-body {
    text-align: center;
    margin-bottom: 1rem;
  }

  .ref-label {
    display: block;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: 0.35rem;
  }

  .ref-code {
    font-family: monospace;
    font-size: 1.4rem;
    font-weight: 800;
    color: #dc2626;
    letter-spacing: 0.08em;
    margin-bottom: 0.75rem;
  }

  .barcode-container {
    display: flex;
    justify-content: center;
    background: white;
    padding: 0.5rem;
    border-radius: 4px;
    margin-inline: auto;
    width: fit-content;
  }

  .voucher-steps {
    font-size: 0.82rem;
    color: var(--color-text);
  }

  .voucher-steps ol {
    margin: 0.35rem 0 0 1.25rem;
    padding: 0;
  }

  .voucher-steps li {
    margin-bottom: 0.25rem;
  }

  .mp-qr-box {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    background: white;
    padding: 1rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  .spei-grid {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.85rem;
  }

  .spei-item {
    display: flex;
    justify-content: space-between;
    padding: 0.4rem 0.6rem;
    background: var(--color-background);
    border-radius: var(--radius-sm);
  }

  .spei-label {
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .spei-clabe-row {
    align-items: center;
  }

  .spei-clabe {
    font-family: monospace;
    font-size: 0.95rem;
    color: var(--color-primary);
  }

  /* Summary */
  .checkout-summary-card {
    padding: var(--spacing-lg);
    background: var(--color-surface);
    position: sticky;
    top: 5rem;
  }

  .checkout-summary-card h3 {
    margin: 0 0 var(--spacing-md) 0;
    padding-bottom: var(--spacing-sm);
    border-bottom: 1px solid var(--color-border);
    font-size: 1.15rem;
  }

  .order-items-preview-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-height: 250px;
    overflow-y: auto;
    margin-bottom: var(--spacing-md);
    padding-bottom: var(--spacing-sm);
    border-bottom: 1px solid var(--color-border);
  }

  .order-item-mini {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    font-size: 0.85rem;
  }

  .mini-thumb {
    width: 36px;
    height: 48px;
    object-fit: cover;
    border-radius: var(--radius-sm);
    background: #e2e8f0;
  }

  .mini-details {
    flex: 1;
  }

  .mini-title {
    font-weight: 600;
    display: block;
  }

  .mini-meta {
    color: var(--color-text-muted);
    font-size: 0.78rem;
  }

  .mini-price {
    font-weight: 700;
    color: var(--color-text);
  }

  .summary-breakdown {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: var(--spacing-md);
  }

  .breakdown-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
  }

  .row-label {
    color: var(--color-text-muted);
  }

  .row-val {
    font-weight: 600;
  }

  .discount-row {
    color: #059669;
  }

  .row-val-discount {
    font-weight: 700;
    color: #059669;
  }

  .breakdown-sep {
    height: 1px;
    background: var(--color-border);
    margin-block: 0.25rem;
  }

  .total-row {
    font-size: 1.15rem;
  }

  .total-label {
    font-weight: 700;
  }

  .total-val {
    font-weight: 800;
    color: var(--color-primary);
    font-size: 1.35rem;
  }

  .security-guarantee-box {
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius-md);
    margin-bottom: var(--spacing-md);
  }

  .back-cart-link {
    text-align: center;
    margin-top: var(--spacing-md);
    font-size: 0.85rem;
  }

  .back-cart-link a {
    color: var(--color-primary);
  }

  .back-cart-link a:hover {
    text-decoration: underline;
  }

  .alert-error {
    background-color: #fee2e2;
    border: 1px solid #f87171;
    color: #991b1b;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    font-size: 0.88rem;
    margin-bottom: var(--spacing-md);
  }

  .btn-lg {
    padding: 0.9rem 1.25rem;
    font-size: 1.05rem;
  }

  @media (max-width: 850px) {
    .checkout-layout {
      grid-template-columns: 1fr;
    }
    .checkout-summary-card {
      position: static;
    }
  }

  @media (max-width: 600px) {
    .form-row {
      flex-direction: column;
      gap: 0;
    }
    .payment-methods-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<script>
  import { authService } from '../services/auth.js';
  import { cartService } from '../services/cart.js';
  import { apiClient } from '../services/apiClient.js';

  const authBox = document.getElementById('auth-required-box') as HTMLElement;
  const mainView = document.getElementById('checkout-main-view') as HTMLElement;
  const form = document.getElementById('checkout-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-order-btn') as HTMLButtonElement;
  const submitBtnLabel = document.getElementById('btn-submit-label') as HTMLElement;
  const errorAlert = document.getElementById('checkout-error-alert') as HTMLElement;

  const itemsPreview = document.getElementById('order-items-preview') as HTMLElement;
  const subtotalEl = document.getElementById('chk-subtotal') as HTMLElement;
  const discountRow = document.getElementById('chk-discount-row') as HTMLElement;
  const discountEl = document.getElementById('chk-discount') as HTMLElement;
  const shippingEl = document.getElementById('chk-shipping') as HTMLElement;
  const totalEl = document.getElementById('chk-total') as HTMLElement;

  // Virtual Card Live Preview Elements
  const cardNumInput = document.getElementById('card-num-input') as HTMLInputElement;
  const cardHolderInput = document.getElementById('card-holder-input') as HTMLInputElement;
  const cardExpInput = document.getElementById('card-exp-input') as HTMLInputElement;
  const cardCvvInput = document.getElementById('card-cvv-input') as HTMLInputElement;

  const prevCardNum = document.getElementById('preview-card-number') as HTMLElement;
  const prevCardHolder = document.getElementById('preview-card-holder') as HTMLElement;
  const prevCardExp = document.getElementById('preview-card-exp') as HTMLElement;
  const prevCardBrand = document.getElementById('preview-card-brand') as HTMLElement;

  // Copy CLABE Button
  const btnCopyClabe = document.getElementById('btn-copy-clabe') as HTMLElement;
  if (btnCopyClabe) {
    btnCopyClabe.addEventListener('click', () => {
      const clabe = document.getElementById('spei-clabe-val')?.textContent?.replace(/\s+/g, '') || '646180123456789012';
      navigator.clipboard.writeText(clabe);
      btnCopyClabe.textContent = '¡Copiada!';
      setTimeout(() => btnCopyClabe.textContent = 'Copiar CLABE', 2000);
    });
  }

  // 1. Verificación de Autenticación
  if (!authService.isAuthenticated()) {
    if (authBox) authBox.style.display = 'block';
    if (mainView) mainView.style.display = 'none';
  } else {
    if (authBox) authBox.style.display = 'none';
    if (mainView) mainView.style.display = 'grid';

    // 2. Verificar Items en Carrito
    const cartItems = cartService.getItems();
    if (cartItems.length === 0) {
      if ((window as any).showToast) (window as any).showToast('Tu carrito está vacío. Agrega libros primero.', 'info');
      setTimeout(() => {
        window.location.href = '/catalogo';
      }, 400);
    }

    // 3. Prellenar datos del usuario
    const user = authService.getUser();
    if (user) {
      const nombreInput = document.getElementById('nombreCliente') as HTMLInputElement;
      const emailInput = document.getElementById('emailCliente') as HTMLInputElement;
      const telInput = document.getElementById('telefonoCliente') as HTMLInputElement;
      const dirInput = document.getElementById('direccionEnvio') as HTMLTextAreaElement;

      if (nombreInput) {
        nombreInput.value = user.nombre || '';
        if (cardHolderInput) cardHolderInput.value = (user.nombre || '').toUpperCase();
        if (prevCardHolder) prevCardHolder.textContent = (user.nombre || 'NOMBRE DEL TITULAR').toUpperCase();
      }
      if (emailInput) emailInput.value = user.email || '';
      if (telInput && user.telefono) telInput.value = user.telefono;
      if (dirInput && user.direccion) dirInput.value = user.direccion;
    }

    // 4. Renderizar desglose financiero
    if (itemsPreview) {
      itemsPreview.innerHTML = cartItems.map((item) => `
        <div class="order-item-mini">
          <img src="${item.imagen || 'https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?w=100'}" alt="${item.titulo}" class="mini-thumb" />
          <div class="mini-details">
            <span class="mini-title">${item.titulo}</span>
            <span class="mini-meta">Cant: ${item.cantidad} × $${Number(item.precio).toFixed(2)}</span>
          </div>
          <span class="mini-price">$${(Number(item.precio) * Number(item.cantidad)).toFixed(2)}</span>
        </div>
      `).join('');
    }

    const fin = cartService.getFinancials();
    if (subtotalEl) subtotalEl.textContent = `$${fin.subtotal.toFixed(2)} MXN`;
    if (shippingEl) shippingEl.textContent = fin.shipping === 0 ? 'GRATIS' : `$${fin.shipping.toFixed(2)} MXN`;
    if (totalEl) totalEl.textContent = `$${fin.total.toFixed(2)} MXN`;

    if (fin.discount > 0 && discountRow) {
      discountRow.style.display = 'flex';
      if (discountEl) discountEl.textContent = `-$${fin.discount.toFixed(2)} MXN`;
    }

    // 5. Selector Multimétodo Interactivo (Bloque A - Parte 1)
    const methodPanels: Record<string, string> = {
      'TARJETA_CREDITO': 'panel-card',
      'TARJETA_DEBITO': 'panel-card',
      'OXXO_EFECTIVO': 'panel-oxxo',
      'MERCADO_PAGO': 'panel-mercadopago',
      'PAYPAL': 'panel-paypal',
      'TRANSFERENCIA_SPEI': 'panel-spei'
    };

    document.querySelectorAll('.payment-card-option').forEach((opt) => {
      opt.addEventListener('click', () => {
        document.querySelectorAll('.payment-card-option').forEach((o) => o.classList.remove('selected'));
        opt.classList.add('selected');
        const radio = opt.querySelector('input') as HTMLInputElement;
        if (radio) radio.checked = true;

        const method = radio.value;

        // Ocultar todos los paneles
        Object.values(methodPanels).forEach(panelId => {
          const p = document.getElementById(panelId);
          if (p) p.style.display = 'none';
        });

        // Mostrar panel activo
        const activePanelId = methodPanels[method];
        if (activePanelId) {
          const activePanel = document.getElementById(activePanelId);
          if (activePanel) activePanel.style.display = 'block';
        }

        // Si es tarjeta débito, ocultar cuotas
        const installGroup = document.getElementById('installments-group');
        if (installGroup) {
          installGroup.style.display = method === 'TARJETA_CREDITO' ? 'block' : 'none';
        }

        // Actualizar texto del botón
        if (submitBtnLabel) {
          if (method === 'OXXO_EFECTIVO') submitBtnLabel.textContent = 'Generar Ficha OXXO Pay';
          else if (method === 'TRANSFERENCIA_SPEI') submitBtnLabel.textContent = 'Confirmar Orden con SPEI';
          else if (method === 'MERCADO_PAGO') submitBtnLabel.textContent = 'Pagar con Mercado Pago';
          else if (method === 'PAYPAL') submitBtnLabel.textContent = 'Pagar con PayPal';
          else submitBtnLabel.textContent = 'Confirmar y Pagar Orden';
        }
      });
    });

    // Formateadores interactivos de Tarjeta
    if (cardNumInput) {
      cardNumInput.addEventListener('input', (e: any) => {
        let v = e.target.value.replace(/\D/g, '').substring(0, 16);
        let formatted = v.match(/.{1,4}/g)?.join(' ') || v;
        e.target.value = formatted;
        if (prevCardNum) prevCardNum.textContent = formatted || '•••• •••• •••• ••••';

        if (prevCardBrand) {
          if (v.startsWith('4')) prevCardBrand.textContent = 'VISA';
          else if (v.startsWith('5')) prevCardBrand.textContent = 'MASTERCARD';
          else if (v.startsWith('3')) prevCardBrand.textContent = 'AMEX';
          else prevCardBrand.textContent = 'TARJETA';
        }
      });
    }

    if (cardHolderInput) {
      cardHolderInput.addEventListener('input', (e: any) => {
        const v = e.target.value.toUpperCase();
        if (prevCardHolder) prevCardHolder.textContent = v || 'NOMBRE DEL TITULAR';
      });
    }

    if (cardExpInput) {
      cardExpInput.addEventListener('input', (e: any) => {
        let v = e.target.value.replace(/\D/g, '').substring(0, 4);
        if (v.length >= 2) {
          v = `${v.substring(0, 2)}/${v.substring(2)}`;
        }
        e.target.value = v;
        if (prevCardExp) prevCardExp.textContent = v || 'MM/AA';
      });
    }

    // 6. MOTOR DE VALIDACIÓN DE PAGO (Bloque A - Parte 2)
    function validatePaymentForm(method: string): string | null {
      const nombre = (document.getElementById('nombreCliente') as HTMLInputElement)?.value.trim();
      const email = (document.getElementById('emailCliente') as HTMLInputElement)?.value.trim();
      const tel = (document.getElementById('telefonoCliente') as HTMLInputElement)?.value.trim();
      const dir = (document.getElementById('direccionEnvio') as HTMLTextAreaElement)?.value.trim();

      if (!nombre || !email || !tel || !dir) {
        return 'Por favor, completa todos los campos requeridos de envío y contacto.';
      }

      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(email)) {
        return 'El correo electrónico ingresado no tiene un formato válido.';
      }

      if (tel.replace(/\D/g, '').length < 10) {
        return 'El teléfono de contacto debe tener 10 dígitos numéricos.';
      }

      if (method === 'TARJETA_CREDITO' || method === 'TARJETA_DEBITO') {
        const rawCard = cardNumInput?.value.replace(/\s+/g, '') || '';
        const exp = cardExpInput?.value.trim() || '';
        const cvv = cardCvvInput?.value.trim() || '';
        const holder = cardHolderInput?.value.trim() || '';

        if (rawCard.length < 15) {
          return 'El número de tarjeta debe tener entre 15 y 16 dígitos.';
        }
        if (!holder) {
          return 'Ingresa el nombre del titular como figura en la tarjeta.';
        }
        if (!/^\d{2}\/\d{2}$/.test(exp)) {
          return 'La fecha de expiración debe tener el formato MM/AA (ej. 12/28).';
        }
        const [month, year] = exp.split('/').map(Number);
        if (month < 1 || month > 12) {
          return 'El mes de vencimiento de la tarjeta debe ser entre 01 y 12.';
        }
        if (cvv.length < 3) {
          return 'El código de seguridad CVV debe tener al menos 3 dígitos.';
        }
      }

      return null;
    }

    // 7. Enviar la Orden a GraphQL
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (errorAlert) errorAlert.style.display = 'none';

        const radio = document.querySelector('input[name="metodoPago"]:checked') as HTMLInputElement;
        const metodoPago = radio ? radio.value : 'TARJETA_CREDITO';

        // Ejecutar motor de validación
        const validationError = validatePaymentForm(metodoPago);
        if (validationError) {
          if (errorAlert) {
            errorAlert.textContent = validationError;
            errorAlert.style.display = 'block';
          }
          window.scrollTo({ top: 100, behavior: 'smooth' });
          return;
        }

        const nombreCliente = (document.getElementById('nombreCliente') as HTMLInputElement).value.trim();
        const emailCliente = (document.getElementById('emailCliente') as HTMLInputElement).value.trim();
        const direccionEnvio = (document.getElementById('direccionEnvio') as HTMLTextAreaElement).value.trim();
        const ciudad = (document.getElementById('ciudadCliente') as HTMLInputElement).value.trim();
        const fullAddress = `${direccionEnvio}, ${ciudad}`;

        const items = cartItems.map((i) => ({
          productoId: i.id,
          cantidad: i.cantidad
        }));

        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span>⏳ Procesando pago seguro y emitiendo folio...</span>';

        const mutation = `
          mutation CrearPedidoDirecto($datos: PedidoInput!) {
            crearPedido(datos: $datos) {
              id
              folio
              fecha
              subtotal
              envio
              total
              status
              metodoPago
              nombreCliente
            }
          }
        `;

        try {
          const res = await apiClient.mutation(mutation, {
            datos: {
              items,
              metodoPago,
              direccionEnvio: fullAddress,
              nombreCliente,
              emailCliente,
              usuarioId: user ? user.id : null
            }
          });

          if (res?.crearPedido?.folio) {
            // Guardar detalles del comprobante para imprimir
            sessionStorage.setItem('last_order_details', JSON.stringify({
              ...res.crearPedido,
              detalles: cartItems,
              emailCliente,
              direccionEnvio: fullAddress
            }));

            cartService.clearCart();
            if ((window as any).showToast) {
              (window as any).showToast('¡Pago aprobado y orden registrada con éxito!', 'success');
            }
            setTimeout(() => {
              window.location.href = `/orden-confirmada?folio=${res.crearPedido.folio}`;
            }, 400);
          } else {
            throw new Error('No se recibió el folio oficial de confirmación.');
          }
        } catch (err: any) {
          if (errorAlert) {
            errorAlert.textContent = err.message || 'Error al procesar el pago. Por favor intenta nuevamente.';
            errorAlert.style.display = 'block';
          }
          submitBtn.disabled = false;
          submitBtn.innerHTML = '<span>Confirmar y Pagar Orden</span>';
        }
      });
    }
  }
</script>
