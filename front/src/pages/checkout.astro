---
import BaseLayout from '../layouts/BaseLayout.astro';
import PaymentGateway from '../components/islands/PaymentGateway.jsx';
const pageTitle = "Finalizar Compra (Checkout) — BiblioTech Store";
---

<BaseLayout pageTitle={pageTitle}>
  <div class="checkout-page">
    <div class="container">
      
      <!-- Bloque de Protección de Ruta (si no está autenticado) -->
      <div id="auth-required-box" class="card auth-warning-card" style="display: none;">
        <div class="warning-icon">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
        </div>
        <h2>Se requiere inicio de sesión</h2>
        <p>Para garantizar la seguridad de tu compra y emitir tu orden formal con seguimiento, necesitas acceder con tu cuenta.</p>
        <div class="auth-warning-actions">
          <a href="/login?redirect=/checkout" class="btn btn-primary">Iniciar Sesión</a>
          <a href="/registro?redirect=/checkout" class="btn btn-outline">Crear una Cuenta</a>
        </div>
      </div>

      <!-- Formulario de Checkout (si está autenticado) -->
      <div id="checkout-main-view" class="checkout-layout" style="display: none;">
        
        <div class="checkout-form-col">
          <div class="checkout-hero">
            <h1>Finalizar Compra</h1>
            <p>Completa los datos de envío y selecciona tu método de pago preferido.</p>
          </div>

          <div id="checkout-error-alert" class="alert-error" style="display: none;"></div>

          <form id="checkout-form" class="checkout-form">
            
            <!-- Sección 1: Datos de Contacto y Envío -->
            <div class="card form-section-card">
              <div class="section-title-row">
                <span class="step-num">1</span>
                <h3>Dirección de Envío y Contacto</h3>
              </div>

              <div class="form-row">
                <div class="form-group form-col">
                  <label class="form-label" for="nombreCliente">Nombre Completo *</label>
                  <input type="text" id="nombreCliente" class="form-input" required />
                </div>
                <div class="form-group form-col">
                  <label class="form-label" for="emailCliente">Correo Electrónico *</label>
                  <input type="email" id="emailCliente" class="form-input" required />
                </div>
              </div>

              <div class="form-row">
                <div class="form-group form-col">
                  <label class="form-label" for="telefonoCliente">Teléfono de Contacto</label>
                  <input 
                    type="tel" 
                    id="telefonoCliente" 
                    class="form-input" 
                    placeholder="Ej. 3312345678"
                    inputmode="numeric"
                    pattern="[0-9]{10}"
                    maxlength="10"
                    autocomplete="tel"
                    aria-describedby="telefono-help"
                    />
                    <small
                      id="telefono-help"
                      style="display: block; margin-top: 4px; font-size: 0.78rem; color: var(--color-text-muted);"
                    > 
                      Solo números. Si se captura, deben ser 10 digitos
                    </small>
                </div>
                <div class="form-group form-col">
                  <label class="form-label" for="ciudadCliente">Ciudad / Estado *</label>
                  <input type="text" id="ciudadCliente" class="form-input" value="Guadalajara, Jalisco" required />
                </div>
              </div>

              <div class="form-group">
                <label class="form-label" for="direccionEnvio">Dirección Completa de Entrega (Calle, Número, Colonia, C.P.) *</label>
                <textarea id="direccionEnvio" class="form-textarea" rows="2" required placeholder="Ej. Av. del Parque 1234, Col. Bosques, C.P. 44100"></textarea>
              </div>
            </div>

            <!-- Sección 2: Método de Pago Seguro (Hugo - Pasarela Multimétodo Interactiva) -->
            <PaymentGateway client:load />

            <!-- Botón de Envío -->
            <button type="submit" id="submit-order-btn" class="btn btn-primary btn-block btn-lg">
              <span>Confirmar y Pagar Orden</span>
            </button>
          </form>
        </div>

        <!-- Columna Resumen de la Orden -->
        <aside class="checkout-summary-col">
          <div class="card checkout-summary-card">
            <h3>Tu Pedido</h3>
            
            <div id="order-items-preview" class="order-items-preview-list">
              <!-- Renderizado dinámicamente -->
            </div>

            <div class="summary-breakdown">
              <div class="breakdown-row">
                <span class="row-label">Subtotal</span>
                <span id="chk-subtotal" class="row-val">$0.00 MXN</span>
              </div>
              <div id="chk-discount-row" class="breakdown-row discount-row" style="display: none;">
                <span class="row-label">Descuento</span>
                <span id="chk-discount" class="row-val-discount">-$0.00 MXN</span>
              </div>
              <div class="breakdown-row">
                <span class="row-label">Envío</span>
                <span id="chk-shipping" class="row-val">$0.00 MXN</span>
              </div>
              <div class="breakdown-sep"></div>
              <div class="breakdown-row total-row">
                <span class="total-label">Total a Pagar</span>
                <span id="chk-total" class="total-val">$0.00 MXN</span>
              </div>
            </div>

            <div class="back-cart-link">
              <a href="/carrito">← Modificar carrito</a>
            </div>
          </div>
        </aside>

      </div>

    </div>
  </div>
</BaseLayout>

<style>
  .checkout-page {
    padding: var(--spacing-xl) 0 var(--spacing-2xl);
  }

  /* Warning Box */
  .auth-warning-card {
    text-align: center;
    max-width: 520px;
    margin: var(--spacing-2xl) auto;
    padding: var(--spacing-2xl) var(--spacing-xl);
    background: var(--color-surface);
  }

  .warning-icon {
    font-size: 3.5rem;
    margin-bottom: 0.5rem;
  }

  .auth-warning-card h2 {
    margin: 0 0 0.5rem 0;
  }

  .auth-warning-card p {
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-xl);
  }

  .auth-warning-actions {
    display: flex;
    justify-content: center;
    gap: var(--spacing-md);
  }

  /* Layout */
  .checkout-layout {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: var(--spacing-xl);
    align-items: start;
  }

  .checkout-hero {
    margin-bottom: var(--spacing-lg);
  }

  .checkout-hero h1 {
    margin: 0 0 0.25rem 0;
    font-size: 1.85rem;
  }

  .checkout-hero p {
    margin: 0;
    color: var(--color-text-muted);
  }

  .form-section-card {
    padding: var(--spacing-xl);
    background: var(--color-surface);
    margin-bottom: var(--spacing-lg);
  }

  .section-title-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: var(--spacing-lg);
    padding-bottom: var(--spacing-sm);
    border-bottom: 1px solid var(--color-border);
  }

  .step-num {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--color-primary);
    color: white;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
  }

  .section-title-row h3 {
    margin: 0;
    font-size: 1.2rem;
  }

  .form-row {
    display: flex;
    gap: var(--spacing-md);
  }

  .form-col {
    flex: 1;
  }

  /* Payment Methods */
  .payment-methods-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-md);
  }

  .payment-card-option {
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 0.75rem 0.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    cursor: pointer;
    background: var(--color-surface);
    transition: all 0.2s ease;
  }

  .payment-card-option input {
    display: none;
  }

  .payment-card-option:hover {
    border-color: var(--color-primary);
  }

  .payment-card-option.selected {
    border-color: var(--color-primary);
    background: #eff6ff;
  }

  .payment-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  .payment-icon {
    font-size: 1.5rem;
  }

  .payment-name {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .card-simulation-box {
    background: var(--color-background);
    padding: var(--spacing-md);
    border-radius: var(--radius-md);
    border: 1px dashed var(--color-border);
  }

  /* Summary Card */
  .checkout-summary-card {
    padding: var(--spacing-lg);
    background: var(--color-surface);
    position: sticky;
    top: 5rem;
  }

  .checkout-summary-card h3 {
    margin: 0 0 var(--spacing-md) 0;
    padding-bottom: var(--spacing-sm);
    border-bottom: 1px solid var(--color-border);
    font-size: 1.15rem;
  }

  .order-items-preview-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-height: 250px;
    overflow-y: auto;
    margin-bottom: var(--spacing-md);
    padding-bottom: var(--spacing-sm);
    border-bottom: 1px solid var(--color-border);
  }

  .order-item-mini {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    font-size: 0.85rem;
  }

  .mini-thumb {
    width: 36px;
    height: 48px;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }

  .mini-details {
    flex: 1;
  }

  .mini-title {
    font-weight: 600;
    display: block;
  }

  .mini-meta {
    color: var(--color-text-muted);
    font-size: 0.78rem;
  }

  .mini-price {
    font-weight: 700;
    color: var(--color-text);
  }

  .summary-breakdown {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: var(--spacing-md);
  }

  .breakdown-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
  }

  .row-label {
    color: var(--color-text-muted);
  }

  .row-val {
    font-weight: 600;
  }

  .discount-row {
    color: #059669;
  }

  .row-val-discount {
    font-weight: 700;
    color: #059669;
  }

  .breakdown-sep {
    height: 1px;
    background: var(--color-border);
    margin-block: 0.25rem;
  }

  .total-row {
    font-size: 1.15rem;
  }

  .total-label {
    font-weight: 700;
  }

  .total-val {
    font-weight: 800;
    color: var(--color-primary);
    font-size: 1.35rem;
  }

  .back-cart-link {
    text-align: center;
    margin-top: var(--spacing-md);
    font-size: 0.85rem;
  }

  .back-cart-link a {
    color: var(--color-primary);
  }

  .back-cart-link a:hover {
    text-decoration: underline;
  }

  .alert-error {
    background-color: #fee2e2;
    border: 1px solid #f87171;
    color: #991b1b;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    font-size: 0.88rem;
    margin-bottom: var(--spacing-md);
  }

  .btn-lg {
    padding: 0.9rem 1.25rem;
    font-size: 1.05rem;
  }

  @media (max-width: 850px) {
    .checkout-layout {
      grid-template-columns: 1fr;
    }

    .checkout-summary-card {
      position: static;
    }
  }

  @media (max-width: 600px) {
    .form-row {
      flex-direction: column;
      gap: 0;
    }

    .payment-methods-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<script>
  import { authService } from '../services/auth.js';
  import { cartService } from '../services/cart.js';
  import { apiClient } from '../services/apiClient.js';

  const telefonoClienteInput = document.getElementById('telefonoCliente') as HTMLInputElement;
  const authBox = document.getElementById('auth-required-box') as HTMLElement;
  const mainView = document.getElementById('checkout-main-view') as HTMLElement;
  const form = document.getElementById('checkout-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-order-btn') as HTMLButtonElement;
  const errorAlert = document.getElementById('checkout-error-alert') as HTMLElement;

  const itemsPreview = document.getElementById('order-items-preview') as HTMLElement;
  const subtotalEl = document.getElementById('chk-subtotal') as HTMLElement;
  const discountRow = document.getElementById('chk-discount-row') as HTMLElement;
  const discountEl = document.getElementById('chk-discount') as HTMLElement;
  const shippingEl = document.getElementById('chk-shipping') as HTMLElement;
  const totalEl = document.getElementById('chk-total') as HTMLElement;

  if (telefonoClienteInput) {
    telefonoClienteInput.addEventListener('input', () => {
      telefonoClienteInput.value = telefonoClienteInput.value.replace(/\D/g, '').slice(0, 10);
    });
  }

  // 1. Verificar autenticación (Rafa - Protección de Ruta)
  if (!authService.isAuthenticated()) {
    if (authBox) authBox.style.display = 'block';
    if (mainView) mainView.style.display = 'none';
  } else {
    if (authBox) authBox.style.display = 'none';
    if (mainView) mainView.style.display = 'grid';

    // 2. Verificar que haya items en el carrito
    const cartItems = cartService.getItems();
    if (cartItems.length === 0) {
      if ((window as any).showToast) (window as any).showToast('Tu carrito está vacío. Agrega libros primero.', 'info');
      setTimeout(() => {
        window.location.href = '/catalogo';
      }, 500);
    }

    // 3. Prellenar datos del usuario
    const user = authService.getUser();
    if (user) {
      const nombreInput = document.getElementById('nombreCliente') as HTMLInputElement;
      const emailInput = document.getElementById('emailCliente') as HTMLInputElement;
      const telInput = document.getElementById('telefonoCliente') as HTMLInputElement;
      const dirInput = document.getElementById('direccionEnvio') as HTMLTextAreaElement;

      if (nombreInput) nombreInput.value = user.nombre || '';
      if (emailInput) emailInput.value = user.email || '';
      if (telInput && user.telefono) telInput.value = user.telefono;
      if (dirInput && user.direccion) dirInput.value = user.direccion;
    }

    // 4. Renderizar desglose de la orden
    if (itemsPreview) {
      itemsPreview.innerHTML = cartItems.map((item: { imagen: any; titulo: any; cantidad: any; precio: any; }) => `
        <div class="order-item-mini">
          <img src="${item.imagen}" alt="${item.titulo}" class="mini-thumb" />
          <div class="mini-details">
            <span class="mini-title">${item.titulo}</span>
            <span class="mini-meta">Cant: ${item.cantidad} × $${Number(item.precio).toFixed(2)}</span>
          </div>
          <span class="mini-price">$${(Number(item.precio) * Number(item.cantidad)).toFixed(2)}</span>
        </div>
      `).join('');
    }

    const fin = cartService.getFinancials();
    if (subtotalEl) subtotalEl.textContent = `$${fin.subtotal.toFixed(2)} MXN`;
    if (shippingEl) shippingEl.textContent = fin.shipping === 0 ? 'GRATIS' : `$${fin.shipping.toFixed(2)} MXN`;
    if (totalEl) totalEl.textContent = `$${fin.total.toFixed(2)} MXN`;

    if (fin.discount > 0 && discountRow) {
      discountRow.style.display = 'flex';
      if (discountEl) discountEl.textContent = `-$${fin.discount.toFixed(2)} MXN`;
    }

    // 5. Selector de método de pago
    document.querySelectorAll('.payment-card-option').forEach((opt) => {
      opt.addEventListener('click', () => {
        document.querySelectorAll('.payment-card-option').forEach((o) => o.classList.remove('selected'));
        opt.classList.add('selected');
        const radio = opt.querySelector('input') as HTMLInputElement;
        if (radio) radio.checked = true;

        const cardBox = document.getElementById('card-fields-box');
        if (cardBox) {
          cardBox.style.display = (radio.value === 'TARJETA_CREDITO' || radio.value === 'TARJETA_DEBITO') ? 'block' : 'none';
        }
      });
    });

    // 6. Enviar la orden de compra con GraphQL
  let currentPaymentInfo: { metodoPago: string; detallesPago: string | null; referenciaPago: string | null } = {
    metodoPago: 'TARJETA_CREDITO',
    detallesPago: null,
    referenciaPago: null
  };

  window.addEventListener('payment-method-changed', (e: any) => {
    if (e.detail) {
      currentPaymentInfo = {
        metodoPago: e.detail.metodoPago || 'TARJETA_CREDITO',
        detallesPago: e.detail.detallesPago || null,
        referenciaPago: e.detail.referenciaPago || null
      };
    }
  });

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (errorAlert) errorAlert.style.display = 'none';
      
      const overStock = cartItems.find((i: any) => Number(i.cantidad) > Number(i.stock));
      if (overStock) {
        const message = 'Stock insuficiente para "' + overStock.titulo + '". Solicitado: ' + overStock.cantidad + ', disponible: ' + overStock.stock + '.';
        if (errorAlert) {
          errorAlert.textContent = message;
          errorAlert.style.display = 'block';
        }
        if ((window as any).showToast) (window as any).showToast(message, 'error');
        return;
      }

      const telefonoCliente = (document.getElementById('telefonoCliente') as HTMLInputElement).value.trim();
      if (telefonoCliente && !/^\d{10}$/.test(telefonoCliente))
      {
        const message = 'El teléfono debe tener exactamente 10 dígitos.';
        if (errorAlert) {
          errorAlert.textContent = message;
          errorAlert.style.display = 'block';
        }
        if ((window as any).showToast) (window as any).showToast(message, 'error');
        telefonoClienteInput.focus();
        return;
      }

      const nombreCliente = (document.getElementById('nombreCliente') as HTMLInputElement).value.trim();
      const emailCliente = (document.getElementById('emailCliente') as HTMLInputElement).value.trim();
      const direccionEnvio = (document.getElementById('direccionEnvio') as HTMLTextAreaElement).value.trim();
      const ciudad = (document.getElementById('ciudadCliente') as HTMLInputElement).value.trim();
      
      const metodoPago = currentPaymentInfo.metodoPago || 'TARJETA_CREDITO';
      const detallesPago = currentPaymentInfo.detallesPago;
      const referenciaPago = currentPaymentInfo.referenciaPago;

      const fullAddress = `${direccionEnvio}, ${ciudad}`;
      const items = cartItems.map((i: { id: any; cantidad: any; }) => ({
        productoId: i.id,
        cantidad: i.cantidad
      }));

      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span>⏳ Procesando pago y registrando orden...</span>';

      const mutation = `
        mutation CrearPedidoDirecto($datos: PedidoInput!) {
          crearPedido(datos: $datos) {
            id
            folio
            fecha
            subtotal
            envio
            total
            status
            metodoPago
            nombreCliente
            detallesPago
            referenciaPago
          }
        }
      `;

      try {
        const res = await apiClient.mutation(mutation, {
          datos: {
            items,
            metodoPago,
            direccionEnvio: fullAddress,
            nombreCliente,
            emailCliente,
            usuarioId: user ? user.id : null,
            detallesPago,
            referenciaPago
          }
        });

        if (res?.crearPedido?.folio) {
          cartService.clearCart();
          if ((window as any).showToast) {
            (window as any).showToast('¡Orden generada exitosamente!', 'success');
          }
          setTimeout(() => {
            const urlParams = new URLSearchParams({
              folio: res.crearPedido.folio,
              metodo: res.crearPedido.metodoPago || metodoPago,
              ref: res.crearPedido.referenciaPago || ''
            });
            window.location.href = `/orden-confirmada?${urlParams.toString()}`;
          }, 500);
        } else {
          throw new Error('No se recibió el folio de confirmación.');
        }
        } catch (err: any) {
          if (errorAlert) {
            errorAlert.textContent = err.message || 'Error al procesar la orden. Verifica la disponibilidad.';
            errorAlert.style.display = 'block';
          }
          submitBtn.disabled = false;
          submitBtn.innerHTML = '<span>Confirmar y Pagar Orden</span>';
        }
      });
    }
  }
</script>
