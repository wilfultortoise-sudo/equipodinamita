---
import BaseLayout from '../layouts/BaseLayout.astro';
const pageTitle = "Iniciar Sesión — BiblioTech Store";
---

<BaseLayout pageTitle={pageTitle}>
  <div class="auth-page">
    <div class="container auth-container">
      <div class="card auth-card">
        <div class="auth-header">
          <div class="auth-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
          </div>
          <h2>Iniciar Sesión</h2>
          <p class="auth-subtitle">Ingresa a tu cuenta para gestionar tus pedidos y compras</p>
        </div>

        <div id="auth-error-alert" class="alert-error" style="display: none;"></div>
        <div id="auth-success-alert" class="alert-success" style="display: none;"></div>

        <form id="login-form" class="auth-form">
          <div class="form-group">
            <label class="form-label" for="email">Correo Electrónico</label>
            <input 
              type="email" 
              id="email" 
              name="email" 
              class="form-input" 
              placeholder="ejemplo@ceti.mx" 
              required 
              autocomplete="email"
            />
          </div>

          <div class="form-group">
            <label class="form-label" for="password">Contraseña</label>
            <input 
              type="password" 
              id="password" 
              name="password" 
              class="form-input" 
              placeholder="••••••••" 
              required 
              autocomplete="current-password"
            />
          </div>

          <button type="submit" id="login-submit-btn" class="btn btn-primary btn-block">
            <span>Entrar a mi Cuenta</span>
          </button>
        </form>

        <div class="demo-users-box">
          <span class="demo-title">Cuentas de Prueba para Demostración:</span>
          <div class="demo-chips">
            <button type="button" class="chip-btn" data-email="hector.reyes@ceti.mx" data-pass="23100134">
              Admin (Héctor)
            </button>
            <button type="button" class="chip-btn" data-email="juan.perez@example.com" data-pass="cliente1">
              Cliente (Juan)
            </button>
          </div>
        </div>

        <div class="auth-footer">
          <p>¿No tienes una cuenta aún? <a href="/registro" class="auth-link">Regístrate aquí</a></p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .auth-page {
    padding: var(--spacing-2xl) 0;
    min-height: calc(80vh - 4rem);
    display: flex;
    align-items: center;
  }

  .auth-container {
    max-width: 460px;
  }

  .auth-card {
    padding: var(--spacing-xl);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
  }

  .auth-header {
    text-align: center;
    margin-bottom: var(--spacing-lg);
  }

  .auth-icon {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .auth-header h2 {
    margin: 0;
    color: var(--color-text);
    font-size: 1.5rem;
  }

  .auth-subtitle {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-top: 0.35rem;
    margin-bottom: 0;
  }

  .alert-error {
    background-color: #fee2e2;
    border: 1px solid #f87171;
    color: #991b1b;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    font-size: 0.88rem;
    margin-bottom: var(--spacing-md);
  }

  .alert-success {
    background-color: #d1fae5;
    border: 1px solid #34d399;
    color: #065f46;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    font-size: 0.88rem;
    margin-bottom: var(--spacing-md);
  }

  .demo-users-box {
    margin-top: var(--spacing-lg);
    padding: 0.75rem;
    background: var(--color-background);
    border-radius: var(--radius-md);
    border: 1px dashed var(--color-border);
  }

  .demo-title {
    display: block;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-text-muted);
    margin-bottom: 0.4rem;
  }

  .demo-chips {
    display: flex;
    gap: 0.5rem;
  }

  .chip-btn {
    flex: 1;
    font-size: 0.75rem;
    padding: 0.35rem 0.5rem;
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    text-align: center;
    transition: all 0.15s ease;
  }

  .chip-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    background: #eff6ff;
  }

  .auth-footer {
    text-align: center;
    margin-top: var(--spacing-lg);
    padding-top: var(--spacing-md);
    border-top: 1px solid var(--color-border);
    font-size: 0.88rem;
    color: var(--color-text-muted);
  }

  .auth-link {
    color: var(--color-primary);
    font-weight: 600;
  }

  .auth-link:hover {
    text-decoration: underline;
  }
</style>

<script>
  import { authService } from '../services/auth.js';

  // Si ya tiene sesión, redirigir
  if (authService.isAuthenticated()) {
    const params = new URLSearchParams(window.location.search);
    const redirect = params.get('redirect') || '/';
    window.location.href = redirect;
  }

  // Cuentas demo
  document.querySelectorAll('.chip-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const email = target.dataset.email || '';
      const pass = target.dataset.pass || '';
      const emailInput = document.getElementById('email') as HTMLInputElement;
      const passInput = document.getElementById('password') as HTMLInputElement;
      if (emailInput && passInput) {
        emailInput.value = email;
        passInput.value = pass;
      }
    });
  });

  const form = document.getElementById('login-form') as HTMLFormElement;
  const submitBtn = document.getElementById('login-submit-btn') as HTMLButtonElement;
  const errorAlert = document.getElementById('auth-error-alert') as HTMLDivElement;
  const successAlert = document.getElementById('auth-success-alert') as HTMLDivElement;

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorAlert.style.display = 'none';
      successAlert.style.display = 'none';

      const email = (document.getElementById('email') as HTMLInputElement).value.trim();
      const password = (document.getElementById('password') as HTMLInputElement).value;

      if (!email || !password) {
        errorAlert.textContent = 'Por favor completa todos los campos.';
        errorAlert.style.display = 'block';
        return;
      }

      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span>Verificando credenciales...</span>';

      try {
        const res = await authService.login(email, password);
        successAlert.textContent = `¡Bienvenido de nuevo, ${res.usuario.nombre}! Redirigiendo...`;
        successAlert.style.display = 'block';

        if ((window as any).showToast) {
          (window as any).showToast(`Sesión iniciada como ${res.usuario.nombre}`, 'success');
        }

        const params = new URLSearchParams(window.location.search);
        const redirect = params.get('redirect') || '/';

        setTimeout(() => {
          window.location.href = redirect;
        }, 600);
      } catch (err: any) {
        errorAlert.textContent = err.message || 'Error al iniciar sesión. Verifica tus datos.';
        errorAlert.style.display = 'block';
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<span>Entrar a mi Cuenta</span>';
      }
    });
  }
</script>
