{
  "name": "ecommerce-graphql-backend",
  "version": "1.0.0",
  "description": "Backend GraphQL con Apollo Server y SQLite para E-commerce BiblioTech",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node --watch-path=index.js --watch-path=resolvers.js --watch-path=mercadopago.js --watch-path=schema.js --watch-path=db.js index.js",
    "dev": "node --watch-path=index.js --watch-path=resolvers.js --watch-path=mercadopago.js --watch-path=schema.js --watch-path=db.js index.js",
    "test": "node test_subscriptions.js",
    "test:db": "node test_db_step3.js",
    "test:mcp": "node test_mcp_stdio.js",
    "mcp": "node mcp_server.js",
    "migrate:pg": "node migrate_to_postgres.js"
  },
  "dependencies": {
    "@apollo/server": "^4.10.0",
    "@google/genai": "^2.32.0",
    "@graphql-tools/schema": "^10.1.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "graphql": "^16.8.0",
    "graphql-subscriptions": "^3.0.0",
    "graphql-ws": "^6.4.1",
    "mercadopago": "^3.6.1",
    "mongodb": "^7.8.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  }
}
