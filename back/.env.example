# ============================================================
# BASE DE DATOS RELACIONAL: PostgreSQL (Paso 3)
# ============================================================
# Compatible con Supabase, Neon, Render, Railway o PostgreSQL local
# Si no se proporciona o no hay conexión, opera en modo dual con SQLite local
# Ejemplo Neon/Supabase: postgresql://neondb_owner:npg_xyz@ep-cool-fog-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bibliotech

# ============================================================
# BASE DE DATOS NO RELACIONAL: MongoDB (Paso 3)
# ============================================================
# Compatible con MongoDB Atlas Cloud o MongoDB local
# Colecciones gestionadas: 'resenas' (calificaciones) y 'auditoria_pedidos'
# Ejemplo Atlas: mongodb+srv://usuario:password@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin:admin123@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=bibliotech_nosql
